llvm-libc has no long double versions of most of the C99 math functions, and
numpy 2.x calls them unconditionally. On llvm-libc they are taken from the
double functions. glibc builds are not changed.

--- a/numpy/_core/include/numpy/npy_math.h
+++ b/numpy/_core/include/numpy/npy_math.h
@@ -4,6 +4,34 @@
 #include <numpy/npy_common.h>
 
 #include <math.h>
+#if defined(__LLVM_LIBC__)
+/*
+ * llvm-libc has no long double versions of these, and numpy calls them
+ * unconditionally. They are taken from the double functions, which gives a
+ * long double only the precision of a double in them. A glibc build does not
+ * come here.
+ */
+static inline long double sinl(long double x) { return (long double)sin((double)x); }
+static inline long double cosl(long double x) { return (long double)cos((double)x); }
+static inline long double tanl(long double x) { return (long double)tan((double)x); }
+static inline long double sinhl(long double x) { return (long double)sinh((double)x); }
+static inline long double coshl(long double x) { return (long double)cosh((double)x); }
+static inline long double tanhl(long double x) { return (long double)tanh((double)x); }
+static inline long double asinl(long double x) { return (long double)asin((double)x); }
+static inline long double acosl(long double x) { return (long double)acos((double)x); }
+static inline long double atanl(long double x) { return (long double)atan((double)x); }
+static inline long double asinhl(long double x) { return (long double)asinh((double)x); }
+static inline long double acoshl(long double x) { return (long double)acosh((double)x); }
+static inline long double atanhl(long double x) { return (long double)atanh((double)x); }
+static inline long double expl(long double x) { return (long double)exp((double)x); }
+static inline long double exp2l(long double x) { return (long double)exp2((double)x); }
+static inline long double expm1l(long double x) { return (long double)expm1((double)x); }
+static inline long double logl(long double x) { return (long double)log((double)x); }
+static inline long double log10l(long double x) { return (long double)log10((double)x); }
+static inline long double log1pl(long double x) { return (long double)log1p((double)x); }
+static inline long double cbrtl(long double x) { return (long double)cbrt((double)x); }
+static inline long double hypotl(long double x, long double y) { return (long double)hypot((double)x, (double)y); }
+#endif
 
 /* By adding static inline specifiers to npy_math function definitions when
    appropriate, compiler is given the opportunity to optimize */
