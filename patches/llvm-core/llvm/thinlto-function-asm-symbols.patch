+bool ModuleSymbolTable::inlineAsmMayDefineSymbols(StringRef Asm) {
+  return Asm.contains(".glob") || Asm.contains(".weak");
+}
+
+// Rewrite the asm string of an inline asm call into text the assembler can
+// parse. The operands are not known here, so each reference to one becomes 0,
+// which is enough to find the symbols the asm names. The syntax is that of
+// AsmPrinter::emitInlineAsm.
+static std::string expandInlineAsm(StringRef Asm, InlineAsm::AsmDialect Dialect) {
+  std::string Out;
+  // Position in a $( ... $| ... $) group of dialect alternatives, and whether
+  // the text being read belongs to the dialect in use.
+  bool InAlternatives = false;
+  unsigned Alternative = 0;
+  unsigned Wanted = Dialect == InlineAsm::AD_Intel ? 1 : 0;
+  auto Emit = [&](StringRef Text) {
+    if (!InAlternatives || Alternative == Wanted)
+      Out += Text;
+  };
+  for (size_t I = 0, E = Asm.size(); I != E; ++I) {
+    char C = Asm[I];
+    if (C != '$' || I + 1 == E) {
+      Emit(StringRef(&C, 1));
+      continue;
+    }
+    char N = Asm[++I];
+    switch (N) {
+    case '$':
+      Emit("$");
+      break;
+    case '(':
+      InAlternatives = true;
+      Alternative = 0;
+      break;
+    case '|':
+      ++Alternative;
+      break;
+    case ')':
+      InAlternatives = false;
+      break;
+    case '{': {
+      size_t Close = Asm.find('}', I);
+      if (Close == StringRef::npos)
+        Close = E - 1;
+      // ${N:modifier} is an operand, ${:name} a built in string such as a
+      // unique id. 0 serves for both.
+      Emit("0");
+      I = Close;
+      break;
+    }
+    default:
+      if (isDigit(N)) {
+        while (I + 1 != E && isDigit(Asm[I + 1]))
+          ++I;
+        Emit("0");
+      } else {
+        Emit(StringRef(&C, 1));
+        Emit(StringRef(&N, 1));
+      }
+    }
+  }
+  return Out;
 }
 
