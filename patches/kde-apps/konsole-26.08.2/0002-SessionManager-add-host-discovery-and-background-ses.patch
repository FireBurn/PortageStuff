+/*
+    SPDX-FileCopyrightText: 2026 Mike Lothian <mike@fireburn.co.uk>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#ifndef MUXHOST_H
+#define MUXHOST_H
+
+#include <QList>
+#include <QString>
+#include <QStringList>
+
+/** A machine whose tmux and screen sessions can be listed: this one, or one reached over ssh. */
+struct MuxHost {
+    enum class Source {
+        Local,
+        SshConfig,
+        SshManager,
+        OpenTab,
+        Manual,
+    };
+
+    QString id; // stable key, "local" or "ssh:<arguments>"
+    QString label;
+    QStringList sshArgs; // empty for the local machine
+    Source source = Source::Local;
+
+    bool isLocal() const
+    {
+        return sshArgs.isEmpty();
+    }
+    bool operator==(const MuxHost &other) const = default;
+};
+
+namespace MuxHosts
+{
+MuxHost local();
+
+/** Host for a destination such as "user@host", "host" or "user@host:2222". */
+MuxHost fromDestination(const QString &destination, MuxHost::Source source);
+
+/** Entries of an OpenSSH client configuration that name a single host (no wildcards). */
+QStringList parseSshConfigAliases(const QString &text);
+
+QList<MuxHost> fromSshConfig();
+QList<MuxHost> fromSshManager();
+
+/** Adds @p extra to @p hosts, skipping hosts whose id is already there. */
+void merge(QList<MuxHost> &hosts, const QList<MuxHost> &extra);
+}
+
+#endif
diff --git a/src/plugins/SessionManager/muxprobe.cpp b/src/plugins/SessionManager/muxprobe.cpp
new file mode 100644
index 000000000..82fee5418
--- /dev/null
+++ b/src/plugins/SessionManager/muxprobe.cpp
@@ -0,0 +1,99 @@
+/*
+    SPDX-FileCopyrightText: 2026 Mike Lothian <mike@fireburn.co.uk>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "muxprobe.h"
+
+#include <QDir>
+#include <QProcess>
+#include <QStandardPaths>
+#include <QTimer>
+
+MuxProbe::MuxProbe(QObject *parent)
+    : QObject(parent)
+{
+    qRegisterMetaType<MuxProbe::Status>();
+    qRegisterMetaType<Multiplexer::ProbeResult>();
+}
+
+QString MuxProbe::controlPath() const
+{
+    // Sockets must stay under the sun_path limit, so keep the name short.
+    const QString dir = QStandardPaths::writableLocation(QStandardPaths::RuntimeLocation);
+    return (dir.isEmpty() ? QDir::tempPath() : dir) + QStringLiteral("/konsole-mux-%C");
+}
+
+QProcess *MuxProbe::start(const MuxHost &host, const QString &command)
+{
+    auto *process = new QProcess(this);
+    process->setProcessChannelMode(QProcess::SeparateChannels);
+    if (host.isLocal()) {
+        process->start(QStringLiteral("sh"), {QStringLiteral("-c"), command});
+    } else {
+        process->start(QStringLiteral("ssh"), Multiplexer::remoteQueryArguments(host.sshArgs, command, controlPath()));
+    }
+    // A host that accepts the connection but never answers must not stall the panel.
+    QTimer::singleShot(20000, process, [process] {
+        if (process->state() != QProcess::NotRunning) {
+            process->kill();
+        }
+    });
+    return process;
+}
+
+bool MuxProbe::isProbing(const MuxHost &host) const
+{
+    return m_running.value(host.id) != nullptr;
+}
+
+void MuxProbe::probe(const MuxHost &host)
+{
+    if (isProbing(host)) {
+        return;
+    }
+    QProcess *process = start(host, Multiplexer::probeCommand());
+    m_running.insert(host.id, process);
+    const QString hostId = host.id;
+    const bool local = host.isLocal();
+    connect(process, &QProcess::finished, this, [this, process, hostId, local](int exitCode, QProcess::ExitStatus exitStatus) {
+        m_running.remove(hostId);
+        Multiplexer::ProbeResult result;
+        Status status = Status::Ok;
+        if (exitStatus != QProcess::NormalExit || exitCode != 0) {
+            const QString errorText = QString::fromUtf8(process->readAllStandardError());
+            const bool login = errorText.contains(QLatin1String("Permission denied")) || errorText.contains(QLatin1String("Host key verification failed"));
+            status = (!local && login) ? Status::NeedsLogin : Status::Unreachable;
+        } else {
+            result = Multiplexer::parseProbeOutput(QString::fromUtf8(process->readAllStandardOutput()));
+        }
+        process->deleteLater();
+        Q_EMIT probed(hostId, status, result);
+    });
+    connect(process, &QProcess::errorOccurred, this, [process](QProcess::ProcessError error) {
+        // finished() is not emitted when the program cannot be started.
+        if (error == QProcess::FailedToStart) {
+            Q_EMIT process->finished(127, QProcess::NormalExit);
+        }
+    });
+}
+
+void MuxProbe::run(const MuxHost &host, const QString &command)
+{
+    QProcess *process = start(host, command);
+    const QString hostId = host.id;
+    connect(process, &QProcess::finished, this, [this, process, hostId](int exitCode, QProcess::ExitStatus exitStatus) {
+        const bool success = exitStatus == QProcess::NormalExit && exitCode == 0;
+        const QString errorText = QString::fromUtf8(process->readAllStandardError()).trimmed();
+        process->deleteLater();
+        Q_EMIT commandFinished(hostId, success, errorText);
+    });
+    connect(process, &QProcess::errorOccurred, this, [process](QProcess::ProcessError error) {
+        if (error == QProcess::FailedToStart) {
+            Q_EMIT process->finished(127, QProcess::NormalExit);
+        }
+    });
+}
+
+#include "moc_muxprobe.cpp"
diff --git a/src/plugins/SessionManager/muxprobe.h b/src/plugins/SessionManager/muxprobe.h
new file mode 100644
index 000000000..e5e9faf49
--- /dev/null
+++ b/src/plugins/SessionManager/muxprobe.h
@@ -0,0 +1,51 @@
+/*
+    SPDX-FileCopyrightText: 2026 Mike Lothian <mike@fireburn.co.uk>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#ifndef MUXPROBE_H
+#define MUXPROBE_H
+
+#include <QHash>
+#include <QObject>
+#include <QPointer>
+
+#include "multiplexer.h"
+#include "muxhost.h"
+
+class QProcess;
+
+/** Lists the tmux and screen sessions of hosts in the background, and runs actions on them. */
+class MuxProbe : public QObject
+{
+    Q_OBJECT
+public:
+    enum class Status {
+        Ok,
+        NeedsLogin, // ssh could not log in without asking a question
+        Unreachable,
+    };
+
+    explicit MuxProbe(QObject *parent = nullptr);
+
+    void probe(const MuxHost &host);
+    bool isProbing(const MuxHost &host) const;
+    /** Runs @p command on the host and reports whether it succeeded. */
+    void run(const MuxHost &host, const QString &command);
+
+Q_SIGNALS:
+    void probed(const QString &hostId, MuxProbe::Status status, const Multiplexer::ProbeResult &result);
+    void commandFinished(const QString &hostId, bool success, const QString &errorText);
+
+private:
+    QProcess *start(const MuxHost &host, const QString &command);
+    QString controlPath() const;
+
+    QHash<QString, QPointer<QProcess>> m_running;
+};
+
+Q_DECLARE_METATYPE(MuxProbe::Status)
+Q_DECLARE_METATYPE(Multiplexer::ProbeResult)
+
+#endif
