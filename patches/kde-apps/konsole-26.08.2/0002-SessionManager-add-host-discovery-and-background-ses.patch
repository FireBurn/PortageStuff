@@ -0,0 +1,83 @@
+/*
+    SPDX-FileCopyrightText: 2026 Mike Lothian <mike@fireburn.co.uk>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include <QSignalSpy>
+#include <QTest>
+
+#include "../muxhost.h"
+#include "../muxprobe.h"
+
+class MuxHostTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void sshConfigAliases();
+    void destinations();
+    void mergeSkipsKnown();
+    void probeLocal();
+    void probeUnreachableSsh();
+};
+
+void MuxHostTest::sshConfigAliases()
+{
+    const QString config = QStringLiteral(
+        "# comment\n"
+        "Host quark\n"
+        "    HostName 10.0.0.2\n"
+        "Host *\n"
+        "    ServerAliveInterval 30\n"
+        "host a b !c d*  # trailing\n"
+        "Host=eq\n"
+        "Hostname notahost\n");
+    QCOMPARE(MuxHosts::parseSshConfigAliases(config), (QStringList{QStringLiteral("quark"), QStringLiteral("a"), QStringLiteral("b"), QStringLiteral("eq")}));
+}
+
+void MuxHostTest::destinations()
+{
+    const MuxHost plain = MuxHosts::fromDestination(QStringLiteral("me@quark"), MuxHost::Source::Manual);
+    QCOMPARE(plain.sshArgs, QStringList{QStringLiteral("me@quark")});
+    QVERIFY(!plain.isLocal());
+
+    const MuxHost port = MuxHosts::fromDestination(QStringLiteral("quark:2222"), MuxHost::Source::Manual);
+    QCOMPARE(port.sshArgs, (QStringList{QStringLiteral("-p"), QStringLiteral("2222"), QStringLiteral("quark")}));
+
+    const MuxHost v6 = MuxHosts::fromDestination(QStringLiteral("fe80::1"), MuxHost::Source::Manual);
+    QCOMPARE(v6.sshArgs, QStringList{QStringLiteral("fe80::1")});
+
+    QVERIFY(MuxHosts::local().isLocal());
+}
+
+void MuxHostTest::mergeSkipsKnown()
+{
+    QList<MuxHost> hosts{MuxHosts::local(), MuxHosts::fromDestination(QStringLiteral("a"), MuxHost::Source::SshConfig)};
+    MuxHosts::merge(
+        hosts,
+        {MuxHosts::fromDestination(QStringLiteral("a"), MuxHost::Source::Manual), MuxHosts::fromDestination(QStringLiteral("b"), MuxHost::Source::Manual)});
+    QCOMPARE(hosts.size(), 3);
+    QCOMPARE(hosts[1].source, MuxHost::Source::SshConfig);
+}
+
+void MuxHostTest::probeLocal()
+{
+    MuxProbe probe;
+    QSignalSpy spy(&probe, &MuxProbe::probed);
+    probe.probe(MuxHosts::local());
+    QVERIFY(spy.wait(15000));
+    QCOMPARE(spy.at(0).at(1).value<MuxProbe::Status>(), MuxProbe::Status::Ok);
+}
+
+void MuxHostTest::probeUnreachableSsh()
+{
+    MuxProbe probe;
+    QSignalSpy spy(&probe, &MuxProbe::probed);
+    // The .invalid TLD never resolves.
+    probe.probe(MuxHosts::fromDestination(QStringLiteral("nobody@nowhere.invalid"), MuxHost::Source::Manual));
+    QVERIFY(spy.wait(15000));
+    QVERIFY(spy.at(0).at(1).value<MuxProbe::Status>() != MuxProbe::Status::Ok);
+}
+
+QTEST_GUILESS_MAIN(MuxHostTest)
+#include "MuxHostTest.moc"
diff --git a/src/plugins/SessionManager/muxhost.cpp b/src/plugins/SessionManager/muxhost.cpp
new file mode 100644
index 000000000..1c5acc4bd
--- /dev/null
+++ b/src/plugins/SessionManager/muxhost.cpp
@@ -0,0 +1,142 @@
+/*
+    SPDX-FileCopyrightText: 2026 Mike Lothian <mike@fireburn.co.uk>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "muxhost.h"
+
+#include <KConfig>
+#include <KConfigGroup>
+#include <KLocalizedString>
+
+#include <QDir>
+#include <QFile>
+#include <QRegularExpression>
+#include <QSysInfo>
+
+namespace MuxHosts
+{
+MuxHost local()
+{
+    MuxHost host;
+    host.id = QStringLiteral("local");
+    host.label = i18nc("@item:inlistbox the computer Konsole is running on", "This computer (%1)", QSysInfo::machineHostName());
+    host.source = MuxHost::Source::Local;
+    return host;
+}
+
+static MuxHost remote(const QStringList &args, const QString &label, MuxHost::Source source)
+{
+    MuxHost host;
+    host.id = QStringLiteral("ssh:") + args.join(QLatin1Char(' '));
+    host.label = label;
+    host.sshArgs = args;
+    host.source = source;
+    return host;
+}
+
+MuxHost fromDestination(const QString &destination, MuxHost::Source source)
+{
+    const QString trimmed = destination.trimmed();
+    static const QRegularExpression withPort(QStringLiteral("^(.+):([0-9]{1,5})$"));
+    const QRegularExpressionMatch match = withPort.match(trimmed);
+    // A second colon means an IPv6 address, not a port.
+    if (match.hasMatch() && !match.captured(1).contains(QLatin1Char(':'))) {
+        return remote({QStringLiteral("-p"), match.captured(2), match.captured(1)}, match.captured(1), source);
+    }
+    return remote({trimmed}, trimmed, source);
+}
+
+QStringList parseSshConfigAliases(const QString &text)
+{
+    QStringList aliases;
+    const auto lines = text.split(QLatin1Char('\n'));
+    for (const QString &rawLine : lines) {
+        const QString line = rawLine.trimmed();
+        if (line.startsWith(QLatin1Char('#'))) {
+            continue;
+        }
+        static const QRegularExpression hostLine(QStringLiteral("^Host(?:\\s+|\\s*=\\s*)(.+)$"), QRegularExpression::CaseInsensitiveOption);
+        const QRegularExpressionMatch match = hostLine.match(line);
+        if (!match.hasMatch()) {
+            continue;
+        }
+        const QStringList names = match.captured(1).split(QRegularExpression(QStringLiteral("\\s+")), Qt::SkipEmptyParts);
+        for (const QString &name : names) {
+            if (name.startsWith(QLatin1Char('#'))) {
+                break;
+            }
+            if (name.contains(QLatin1Char('*')) || name.contains(QLatin1Char('?')) || name.startsWith(QLatin1Char('!')) || aliases.contains(name)) {
+                continue;
+            }
+            aliases.append(name);
+        }
+    }
+    return aliases;
+}
+
+QList<MuxHost> fromSshConfig()
+{
+    QList<MuxHost> hosts;
+    QFile file(QDir::homePath() + QStringLiteral("/.ssh/config"));
+    if (!file.open(QIODevice::ReadOnly | QIODevice::Text)) {
+        return hosts;
+    }
+    const QStringList aliases = parseSshConfigAliases(QString::fromUtf8(file.readAll()));
+    for (const QString &alias : aliases) {
+        hosts.append(remote({alias}, alias, MuxHost::Source::SshConfig));
+    }
+    return hosts;
+}
+
+QList<MuxHost> fromSshManager()
+{
+    QList<MuxHost> hosts;
+    // Same file the SSH Manager plugin writes. Read only.
+    KConfig config(QStringLiteral("konsolesshconfig"), KConfig::SimpleConfig);
+    const auto folders = config.groupList();
+    for (const QString &folderName : folders) {
+        if (folderName == QLatin1String("Global plugin config")) {
+            continue;
+        }
+        KConfigGroup folder = config.group(folderName);
+        const auto entries = folder.groupList();
+        for (const QString &entryName : entries) {
+            KConfigGroup entry = folder.group(entryName);
+            const QString identifier = entry.readEntry("identifier");
+            const QString hostName = entry.readEntry("hostname");
+            QStringList args;
+            if (entry.readEntry("useSshConfig", false)) {
+                args << identifier;
+            } else {
+                if (!entry.readEntry("sshkey").isEmpty()) {
+                    args << QStringLiteral("-i") << entry.readEntry("sshkey");
+                }
+                if (!entry.readEntry("port").isEmpty()) {
+                    args << QStringLiteral("-p") << entry.readEntry("port");
+                }
+                const QString user = entry.readEntry("username");
+                args << (user.isEmpty() ? hostName : user + QLatin1Char('@') + hostName);
+            }
+            if (args.isEmpty() || args.last().isEmpty()) {
+                continue;
+            }
+            hosts.append(remote(args, identifier.isEmpty() ? hostName : identifier, MuxHost::Source::SshManager));
+        }
+    }
+    return hosts;
+}
+
+void merge(QList<MuxHost> &hosts, const QList<MuxHost> &extra)
+{
+    for (const MuxHost &host : extra) {
+        const bool known = std::any_of(hosts.cbegin(), hosts.cend(), [&host](const MuxHost &h) {
+            return h.id == host.id;
+        });
+        if (!known) {
+            hosts.append(host);
+        }
+    }
+}
+}
