+void SessionManagerPlugin::saveLayout()
+{
+    MuxLayout layout;
+    const auto sessions = Konsole::SessionManager::instance()->sessions();
+    for (const Konsole::Session *session : sessions) {
+        const QStringList parts = session->property(keyProperty).toString().split(QLatin1Char('\n'));
+        MuxLayout::Entry entry;
+        if (parts.size() >= 3 && MuxLayout::decode(parts.at(1) + QLatin1Char(':') + parts.mid(2).join(QLatin1Char('\n')), &entry)) {
+            layout.hosts[parts.at(0)].append(entry);
+        }
+    }
+    m_savedLayout = layout;
+    layout.save();
+}
+
+void SessionManagerPlugin::setRestoreOffer(int count)
+{
+    for (QDockWidget *dock : std::as_const(m_docks)) {
+        static_cast<MuxWidget *>(dock->widget())->setRestoreOffer(count);
+    }
+}
+
+void SessionManagerPlugin::restoreLayout(Konsole::MainWindow *mainWindow)
+{
+    const MuxLayout layout = m_savedLayout;
+    setRestoreOffer(0);
+    for (auto it = layout.hosts.cbegin(); it != layout.hosts.cend(); ++it) {
+        const QString hostId = it.key();
+        const QList<MuxLayout::Entry> wanted = it.value();
+        if (m_model->host(hostId).id.isEmpty()) {
+            continue;
+        }
+        // The tmux or screen server may have restarted since, so look at the host again first.
+        auto *connection = new QMetaObject::Connection;
+        *connection = connect(m_model.get(), &MuxModel::hostUpdated, this, [this, connection, mainWindow, hostId, wanted](const QString &updated) {
+            if (updated != hostId) {
+                return;
+            }
+            disconnect(*connection);
+            delete connection;
+            const QList<Session> running = m_model->result(hostId).sessions;
+            QSet<QString> open;
+            const auto sessions = Konsole::SessionManager::instance()->sessions();
+            for (const Konsole::Session *s : sessions) {
+                open.insert(s->property(keyProperty).toString());
+            }
+            for (const MuxLayout::Entry &entry : wanted) {
+                for (const Session &session : running) {
+                    if (session.tool == entry.tool && session.name == entry.name && !open.contains(MuxModel::sessionKey(hostId, session))) {
+                        openSession(mainWindow, hostId, session, false);
+                    }
+                }
+            }
+        });
+        m_model->refresh(hostId);
+    }
+}
+
