+
+K_PLUGIN_CLASS_WITH_JSON(SessionManagerPlugin, "konsole_sessionmanager.json")
+
+using namespace Multiplexer;
+
+static const char keyProperty[] = "konsoleMuxKey";
+
+SessionManagerPlugin::SessionManagerPlugin(QObject *object, const QVariantList &args)
+    : Konsole::IKonsolePlugin(object, args)
+    , m_model(std::make_unique<MuxModel>())
+    , m_timer(new QTimer(this))
+{
+    setName(QStringLiteral("SessionManager"));
+
+    m_timer->setInterval(10000);
+    connect(m_timer, &QTimer::timeout, this, [this] {
+        updateOpenState();
+        m_model->refreshAll();
+    });
+}
+
+SessionManagerPlugin::~SessionManagerPlugin() = default;
+
+void SessionManagerPlugin::createWidgetsForMainWindow(Konsole::MainWindow *mainWindow)
+{
+    auto *dock = new QDockWidget(mainWindow);
+    auto *widget = new MuxWidget(m_model.get());
+    dock->setWidget(widget);
+    dock->setWindowTitle(i18n("Running Terminals"));
+    dock->setObjectName(QStringLiteral("SessionManagerDock"));
+    dock->setVisible(false);
+    dock->setAllowedAreas(Qt::LeftDockWidgetArea | Qt::RightDockWidgetArea);
+    mainWindow->addDockWidget(Qt::RightDockWidgetArea, dock);
+    m_docks[mainWindow] = dock;
+
+    connect(widget, &MuxWidget::openRequested, this, [this, mainWindow](const QString &hostId, const Session &session, bool takeOver) {
+        openSession(mainWindow, hostId, session, takeOver);
+    });
+    connect(widget, &MuxWidget::openAllRequested, this, [this, mainWindow](const QString &hostId) {
+        openAll(mainWindow, hostId);
+    });
+    connect(widget, &MuxWidget::newRequested, this, [this, mainWindow](const QString &hostId, Tool tool, const QString &name) {
+        createSession(mainWindow, hostId, tool, name);
+    });
+
+    // Only poll while a panel is visible.
+    connect(dock, &QDockWidget::visibilityChanged, this, [this] {
+        const bool anyVisible = std::any_of(m_docks.cbegin(), m_docks.cend(), [](QDockWidget *d) {
+            return d->isVisible();
+        });
+        if (anyVisible) {
+            updateOpenState();
+            m_timer->start();
+        } else {
+            m_timer->stop();
+        }
+    });
+    connect(mainWindow, &QObject::destroyed, this, [this, mainWindow] {
+        m_docks.remove(mainWindow);
+    });
+}
+
+QList<QAction *> SessionManagerPlugin::menuBarActions(Konsole::MainWindow *mainWindow) const
+{
+    auto *toggle = new QAction(i18n("Show Running Terminals"), mainWindow);
+    toggle->setCheckable(true);
+    mainWindow->actionCollection()->setDefaultShortcut(toggle, QKeySequence(Qt::CTRL | Qt::SHIFT | Qt::Key_F3));
+    QDockWidget *dock = m_docks.value(mainWindow);
+    connect(toggle, &QAction::triggered, dock, &QDockWidget::setVisible);
+    connect(dock, &QDockWidget::visibilityChanged, toggle, &QAction::setChecked);
+    return {toggle};
+}
+
+void SessionManagerPlugin::activeViewChanged(Konsole::SessionController *controller, Konsole::MainWindow *mainWindow)
+{
+    Q_UNUSED(controller)
+    Q_UNUSED(mainWindow)
+}
+
+Konsole::Session *
+SessionManagerPlugin::openCommand(Konsole::MainWindow *mainWindow, const QString &hostId, const QString &command, const QString &title, const QString &key)
+{
+    const MuxHost host = m_model->host(hostId);
+    const QString text = host.isLocal() ? command : remoteTerminalCommand(host.sshArgs, command);
+
+    Konsole::Profile::Ptr profile = Konsole::ProfileManager::instance()->defaultProfile();
+    Konsole::Session *session = Konsole::SessionManager::instance()->createSession(profile);
+    const QString tabTitle = host.isLocal() ? title : i18nc("@title:tab session name and computer", "%1 (%2)", title, host.label);
+    session->setTabTitleFormat(Konsole::Session::LocalTabTitle, tabTitle);
+    session->setTabTitleFormat(Konsole::Session::RemoteTabTitle, tabTitle);
+    session->setProperty(keyProperty, key);
+    session->sendTextToTerminal(text, QLatin1Char('\r'));
+
+    // The view must exist before the process starts, see MainWindow::createSSHSession().
+    Konsole::ViewManager *viewManager = mainWindow->viewManager();
+    viewManager->activeContainer()->addView(viewManager->createView(session));
+
+    connect(session, &QObject::destroyed, this, [this] {
+        QTimer::singleShot(0, this, &SessionManagerPlugin::updateOpenState);
+    });
+    updateOpenState();
+    return session;
+}
+
+Konsole::Session *SessionManagerPlugin::openSession(Konsole::MainWindow *mainWindow, const QString &hostId, const Session &session, bool takeOver)
+{
+    return openCommand(mainWindow, hostId, attachCommand(session, takeOver), session.name, MuxModel::sessionKey(hostId, session));
+}
+
+void SessionManagerPlugin::openAll(Konsole::MainWindow *mainWindow, const QString &hostId)
+{
+    const QList<Session> sessions = m_model->result(hostId).sessions;
+    const auto open = Konsole::SessionManager::instance()->sessions();
+    QSet<QString> alreadyOpen;
+    for (const Konsole::Session *s : open) {
+        alreadyOpen.insert(s->property(keyProperty).toString());
+    }
+    for (const Session &session : sessions) {
+        if (!alreadyOpen.contains(MuxModel::sessionKey(hostId, session))) {
+            openSession(mainWindow, hostId, session, false);
+        }
+    }
+}
+
+void SessionManagerPlugin::createSession(Konsole::MainWindow *mainWindow, const QString &hostId, Tool tool, const QString &name)
+{
+    // The name is only known to the tool once it exists, so the tab is not marked as open
+    // until the next refresh finds it.
+    const QString title = name.isEmpty() ? i18n("New terminal") : name;
+    openCommand(mainWindow, hostId, newSessionCommand(tool, name), title, QString());
+    QTimer::singleShot(2000, m_model.get(), [this, hostId] {
+        m_model->refresh(hostId);
+    });
+}
+
+void SessionManagerPlugin::updateOpenState()
+{
+    QSet<QString> keys;
+    QList<MuxHost> tabHosts;
+    const auto sessions = Konsole::SessionManager::instance()->sessions();
+    for (Konsole::Session *session : sessions) {
+        const QString key = session->property(keyProperty).toString();
+        if (!key.isEmpty()) {
+            keys.insert(key);
+        }
+        Konsole::ProcessInfo *info = session->getProcessInfo();
+        bool ok = false;
+        if (info && info->name(&ok) == QLatin1String("ssh") && ok) {
+            const Konsole::SSHProcessInfo ssh(*info);
+            if (!ssh.host().isEmpty() && ssh.command().isEmpty()) {
+                QString destination = ssh.userName().isEmpty() ? ssh.host() : ssh.userName() + QLatin1Char('@') + ssh.host();
+                if (!ssh.port().isEmpty() && ssh.port() != QLatin1String("22")) {
+                    destination += QLatin1Char(':') + ssh.port();
+                }
+                tabHosts.append(MuxHosts::fromDestination(destination, MuxHost::Source::OpenTab));
+            }
+        }
+    }
+    m_model->setOpenKeys(keys);
+    m_model->addOpenTabHosts(tabHosts);
+}
+
