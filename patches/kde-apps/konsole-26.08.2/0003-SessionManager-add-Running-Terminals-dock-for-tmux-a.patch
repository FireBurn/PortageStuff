diff --git a/src/plugins/SessionManager/muxmodel.cpp b/src/plugins/SessionManager/muxmodel.cpp
new file mode 100644
index 000000000..603682fdb
--- /dev/null
+++ b/src/plugins/SessionManager/muxmodel.cpp
@@ -0,0 +1,257 @@
+/*
+    SPDX-FileCopyrightText: 2026 Mike Lothian <mike@fireburn.co.uk>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "muxmodel.h"
+
+#include <KConfigGroup>
+#include <KLocalizedString>
+#include <KSharedConfig>
+
+using namespace Multiplexer;
+
+static const ProbeResult emptyResult;
+
+MuxModel::MuxModel(QObject *parent)
+    : QStandardItemModel(parent)
+{
+    connect(&m_probe, &MuxProbe::probed, this, &MuxModel::onProbed);
+    reloadHosts();
+}
+
+MuxProbe *MuxModel::probe()
+{
+    return &m_probe;
+}
+
+const QList<MuxHost> &MuxModel::hosts() const
+{
+    return m_hosts;
+}
+
+MuxHost MuxModel::host(const QString &hostId) const
+{
+    for (const MuxHost &h : m_hosts) {
+        if (h.id == hostId) {
+            return h;
+        }
+    }
+    return {};
+}
+
+const ProbeResult &MuxModel::result(const QString &hostId) const
+{
+    const auto it = m_results.constFind(hostId);
+    return it == m_results.constEnd() ? emptyResult : *it;
+}
+
+QString MuxModel::sessionKey(const QString &hostId, const Session &session)
+{
+    return hostId + QLatin1Char('\n') + toolName(session.tool) + QLatin1Char('\n') + session.name;
+}
+
+QStringList MuxModel::manualDestinations() const
+{
+    return KSharedConfig::openConfig()->group(QStringLiteral("SessionManager")).readEntry("ManualHosts", QStringList());
+}
+
+QStringList MuxModel::hiddenHosts() const
+{
+    return KSharedConfig::openConfig()->group(QStringLiteral("SessionManager")).readEntry("HiddenHosts", QStringList());
+}
+
+void MuxModel::reloadHosts()
+{
+    m_hosts = {MuxHosts::local()};
+    MuxHosts::merge(m_hosts, MuxHosts::fromSshManager());
+    MuxHosts::merge(m_hosts, MuxHosts::fromSshConfig());
+    QList<MuxHost> manual;
+    for (const QString &destination : manualDestinations()) {
+        manual.append(MuxHosts::fromDestination(destination, MuxHost::Source::Manual));
+    }
+    MuxHosts::merge(m_hosts, manual);
+    MuxHosts::merge(m_hosts, m_openTabHosts);
+    const QStringList hidden = hiddenHosts();
+    m_hosts.removeIf([&hidden](const MuxHost &h) {
+        return !h.isLocal() && hidden.contains(h.id);
+    });
+    rebuild();
+}
+
+void MuxModel::addManualHost(const QString &destination)
+{
+    QStringList list = manualDestinations();
+    const QString trimmed = destination.trimmed();
+    if (trimmed.isEmpty()) {
+        return;
+    }
+    const QString hostId = MuxHosts::fromDestination(trimmed, MuxHost::Source::Manual).id;
+    KConfigGroup group = KSharedConfig::openConfig()->group(QStringLiteral("SessionManager"));
+    if (!list.contains(trimmed)) {
+        list.append(trimmed);
+        group.writeEntry("ManualHosts", list);
+    }
+    QStringList hidden = hiddenHosts();
+    if (hidden.removeAll(hostId) > 0) {
+        group.writeEntry("HiddenHosts", hidden);
+    }
+    group.sync();
+    reloadHosts();
+    refresh(hostId);
+}
+
+void MuxModel::hideHost(const QString &hostId)
+{
+    if (hostId == MuxHosts::local().id) {
+        return;
+    }
+    KConfigGroup group = KSharedConfig::openConfig()->group(QStringLiteral("SessionManager"));
+    QStringList manual = manualDestinations();
+    manual.removeIf([&hostId](const QString &destination) {
+        return MuxHosts::fromDestination(destination, MuxHost::Source::Manual).id == hostId;
+    });
+    group.writeEntry("ManualHosts", manual);
+    QStringList hidden = hiddenHosts();
+    if (!hidden.contains(hostId)) {
+        hidden.append(hostId);
+    }
+    group.writeEntry("HiddenHosts", hidden);
+    group.sync();
+    reloadHosts();
+}
+
+void MuxModel::addOpenTabHosts(const QList<MuxHost> &hosts)
+{
+    if (hosts == m_openTabHosts) {
+        return;
+    }
+    m_openTabHosts = hosts;
+    reloadHosts();
+}
+
+void MuxModel::rebuild()
+{
+    clear();
+    for (const MuxHost &h : std::as_const(m_hosts)) {
+        auto *item = new QStandardItem(h.label);
+        item->setData(HostKind, KindRole);
+        item->setData(h.id, HostIdRole);
+        item->setEditable(false);
+        appendRow(item);
+        updateHost(h.id);
+    }
+}
+
+QStandardItem *MuxModel::hostItem(const QString &hostId) const
+{
+    for (int row = 0; row < rowCount(); ++row) {
+        if (item(row)->data(HostIdRole).toString() == hostId) {
+            return item(row);
+        }
+    }
+    return nullptr;
+}
+
+void MuxModel::refreshAll()
+{
+    for (const MuxHost &h : std::as_const(m_hosts)) {
+        refresh(h.id);
+    }
+}
+
+void MuxModel::refresh(const QString &hostId)
+{
+    const MuxHost h = host(hostId);
+    if (h.id.isEmpty() || m_probe.isProbing(h)) {
+        return;
+    }
+    if (!m_status.contains(hostId)) {
+        if (QStandardItem *item = hostItem(hostId)) {
+            item->setData(i18nc("@info:status", "Checking…"), SummaryRole);
+        }
+    }
+    m_probe.probe(h);
+}
+
+void MuxModel::onProbed(const QString &hostId, MuxProbe::Status status, const ProbeResult &probeResult)
+{
+    m_status.insert(hostId, status);
+    if (status == MuxProbe::Status::Ok) {
+        m_results.insert(hostId, probeResult);
+    }
+    updateHost(hostId);
+}
+
+void MuxModel::setOpenKeys(const QSet<QString> &keys)
+{
+    if (keys == m_openKeys) {
+        return;
+    }
+    m_openKeys = keys;
+    for (int row = 0; row < rowCount(); ++row) {
+        applyOpenState(item(row));
+    }
+}
+
+void MuxModel::applyOpenState(QStandardItem *parent)
+{
+    const QString hostId = parent->data(HostIdRole).toString();
+    for (int row = 0; row < parent->rowCount(); ++row) {
+        QStandardItem *child = parent->child(row);
+        const auto session = child->data(SessionRole).value<Session>();
+        child->setData(m_openKeys.contains(sessionKey(hostId, session)), OpenRole);
+    }
+}
+
+void MuxModel::updateHost(const QString &hostId)
+{
+    QStandardItem *parent = hostItem(hostId);
+    if (!parent) {
+        return;
+    }
+    parent->removeRows(0, parent->rowCount());
+
+    const auto statusIt = m_status.constFind(hostId);
+    if (statusIt == m_status.constEnd()) {
+        parent->setData(i18nc("@info:status", "Checking…"), SummaryRole);
+        return;
+    }
+    parent->setData(QVariant::fromValue(*statusIt), StatusRole);
+
+    const ProbeResult &r = result(hostId);
+    switch (*statusIt) {
+    case MuxProbe::Status::NeedsLogin:
+        parent->setData(i18nc("@info:status", "Needs a login. Connect once in a tab to allow it."), SummaryRole);
+        if (!m_results.contains(hostId)) {
+            return;
+        }
+        break;
+    case MuxProbe::Status::Unreachable:
+        parent->setData(i18nc("@info:status", "Not reachable"), SummaryRole);
+        if (!m_results.contains(hostId)) {
+            return;
+        }
+        break;
+    case MuxProbe::Status::Ok:
+        if (!r.tmuxAvailable && !r.screenAvailable) {
+            parent->setData(i18nc("@info:status", "tmux and screen are not installed"), SummaryRole);
+            return;
+        }
+        parent->setData(i18ncp("@info:status", "%1 running terminal", "%1 running terminals", r.sessions.size()), SummaryRole);
+        break;
+    }
+
+    for (const Session &session : r.sessions) {
+        auto *child = new QStandardItem(session.name);
+        child->setEditable(false);
+        child->setData(SessionKind, KindRole);
+        child->setData(hostId, HostIdRole);
+        child->setData(QVariant::fromValue(session), SessionRole);
+        parent->appendRow(child);
+    }
+    applyOpenState(parent);
+}
+
+#include "moc_muxmodel.cpp"
