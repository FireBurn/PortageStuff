+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#ifndef MUXMODEL_H
+#define MUXMODEL_H
+
+#include <QHash>
+#include <QSet>
+#include <QStandardItemModel>
+
+#include "multiplexer.h"
+#include "muxhost.h"
+#include "muxprobe.h"
+
+/** Hosts at the top level, the sessions found on each below them. */
+class MuxModel : public QStandardItemModel
+{
+    Q_OBJECT
+public:
+    enum Roles {
+        KindRole = Qt::UserRole + 1,
+        HostIdRole,
+        SessionRole,
+        OpenRole, // session is shown in a tab of this Konsole
+        StatusRole,
+        SummaryRole,
+    };
+    enum Kind {
+        HostKind,
+        SessionKind,
+    };
+
+    explicit MuxModel(QObject *parent = nullptr);
+
+    void reloadHosts();
+    void addManualHost(const QString &destination);
+    /** Stops listing a host. Hosts typed in by hand are forgotten, others are only hidden. */
+    void hideHost(const QString &hostId);
+    void addOpenTabHosts(const QList<MuxHost> &hosts);
+
+    void refreshAll();
+    void refresh(const QString &hostId);
+
+    /** Keys from sessionKey() of every session currently shown in a tab. */
+    void setOpenKeys(const QSet<QString> &keys);
+
+    const QList<MuxHost> &hosts() const;
+    MuxHost host(const QString &hostId) const;
+    const Multiplexer::ProbeResult &result(const QString &hostId) const;
+    MuxProbe *probe();
+
+    static QString sessionKey(const QString &hostId, const Multiplexer::Session &session);
+
+private:
+    void rebuild();
+    void updateHost(const QString &hostId);
+    QStandardItem *hostItem(const QString &hostId) const;
+    void applyOpenState(QStandardItem *hostItem);
+    void onProbed(const QString &hostId, MuxProbe::Status status, const Multiplexer::ProbeResult &result);
+    QStringList manualDestinations() const;
+    QStringList hiddenHosts() const;
+
+    MuxProbe m_probe;
+    QList<MuxHost> m_hosts;
+    QList<MuxHost> m_openTabHosts;
+    QHash<QString, Multiplexer::ProbeResult> m_results;
+    QHash<QString, MuxProbe::Status> m_status;
+    QSet<QString> m_openKeys;
+};
+
+#endif
