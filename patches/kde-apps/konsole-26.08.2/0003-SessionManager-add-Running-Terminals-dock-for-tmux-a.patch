+/*
+    SPDX-FileCopyrightText: 2026 Mike Lothian <mike@fireburn.co.uk>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "muxwidget.h"
+
+#include "muxmodel.h"
+
+#include <KLocalizedString>
+#include <KMessageBox>
+
+#include <QApplication>
+#include <QHBoxLayout>
+#include <QInputDialog>
+#include <QLabel>
+#include <QMenu>
+#include <QPainter>
+#include <QPushButton>
+#include <QStyledItemDelegate>
+#include <QToolButton>
+#include <QTreeView>
+#include <QVBoxLayout>
+
+using namespace Multiplexer;
+
+namespace
+{
+QString sessionSubtitle(const Session &session, bool open)
+{
+    QStringList parts;
+    parts << toolName(session.tool);
+    if (!session.command.isEmpty()) {
+        parts << i18nc("@info the program a terminal is running", "running %1", session.command);
+    }
+    if (session.windows > 1) {
+        parts << i18ncp("@info", "%1 window", "%1 windows", session.windows);
+    }
+    if (open) {
+        parts << i18nc("@info a terminal that is shown in a tab right now", "open in a tab");
+    } else if (session.attached()) {
+        parts << i18nc("@info a terminal that something else is connected to", "in use");
+    } else {
+        parts << i18nc("@info a terminal nothing is connected to", "waiting");
+    }
+    return parts.join(QStringLiteral(" · "));
+}
+
+class MuxDelegate : public QStyledItemDelegate
+{
+public:
+    using QStyledItemDelegate::QStyledItemDelegate;
+
+    QSize sizeHint(const QStyleOptionViewItem &option, const QModelIndex &index) const override
+    {
+        Q_UNUSED(index)
+        return QSize(option.rect.width(), option.fontMetrics.height() * 2 + 14);
+    }
+
+    void paint(QPainter *painter, const QStyleOptionViewItem &option, const QModelIndex &index) const override
+    {
+        QStyleOptionViewItem opt = option;
+        initStyleOption(&opt, index);
+        const QString title = opt.text;
+        opt.text.clear();
+        opt.icon = QIcon();
+        QStyle *style = opt.widget ? opt.widget->style() : QApplication::style();
+        style->drawControl(QStyle::CE_ItemViewItem, &opt, painter, opt.widget);
+
+        const bool isHost = index.data(MuxModel::KindRole).toInt() == MuxModel::HostKind;
+        const auto selected = opt.state & QStyle::State_Selected;
+        const QPalette::ColorRole fg = selected ? QPalette::HighlightedText : QPalette::Text;
+        const QColor dim = opt.palette.color(selected ? QPalette::HighlightedText : QPalette::PlaceholderText);
+
+        QString subtitle;
+        QIcon icon;
+        if (isHost) {
+            subtitle = index.data(MuxModel::SummaryRole).toString();
+            icon = QIcon::fromTheme(QStringLiteral("computer"));
+        } else {
+            const auto session = index.data(MuxModel::SessionRole).value<Session>();
+            subtitle = sessionSubtitle(session, index.data(MuxModel::OpenRole).toBool());
+            icon = QIcon::fromTheme(QStringLiteral("utilities-terminal"));
+        }
+
+        const QRect r = opt.rect.adjusted(8, 4, -8, -4);
+        const int iconSize = isHost ? 28 : 22;
+        const QRect iconRect(r.left(), r.top() + (r.height() - iconSize) / 2, iconSize, iconSize);
+        icon.paint(painter, iconRect, Qt::AlignCenter, selected ? QIcon::Selected : QIcon::Normal);
+
+        const QRect textRect = r.adjusted(iconSize + 10, 0, 0, 0);
+        QFont titleFont = opt.font;
+        titleFont.setBold(isHost || index.data(MuxModel::OpenRole).toBool());
+        painter->save();
+        painter->setFont(titleFont);
+        const bool idle = isHost && index.model()->rowCount(index) == 0;
+        painter->setPen(idle && !selected ? dim : opt.palette.color(fg));
+        const QFontMetrics tfm(titleFont);
+        painter->drawText(textRect.adjusted(0, 0, 0, -r.height() / 2),
+                          Qt::AlignLeft | Qt::AlignVCenter,
+                          tfm.elidedText(title, Qt::ElideRight, textRect.width()));
+        painter->setFont(opt.font);
+        painter->setPen(dim);
+        painter->drawText(textRect.adjusted(0, r.height() / 2, 0, 0),
+                          Qt::AlignLeft | Qt::AlignVCenter,
+                          opt.fontMetrics.elidedText(subtitle, Qt::ElideRight, textRect.width()));
+        painter->restore();
+    }
+};
+}
+
+MuxWidget::MuxWidget(MuxModel *model, QWidget *parent)
+    : QWidget(parent)
+    , m_model(model)
+    , m_view(new QTreeView(this))
+    , m_empty(new QLabel(this))
+    , m_openButton(new QPushButton(QIcon::fromTheme(QStringLiteral("media-playback-start")), i18nc("@action:button", "Open"), this))
+    , m_openAllButton(new QPushButton(QIcon::fromTheme(QStringLiteral("view-restore")), i18nc("@action:button", "Open All"), this))
+    , m_newButton(new QToolButton(this))
+{
+    qRegisterMetaType<Multiplexer::Session>();
+
+    m_view->setModel(model);
+    m_view->setHeaderHidden(true);
+    m_view->setItemDelegate(new MuxDelegate(m_view));
+    m_view->setEditTriggers(QAbstractItemView::NoEditTriggers);
+    m_view->setContextMenuPolicy(Qt::CustomContextMenu);
+    m_view->setIndentation(14);
+    m_view->setFrameShape(QFrame::NoFrame);
+    m_view->setUniformRowHeights(true);
+    m_view->setExpandsOnDoubleClick(false);
+    m_view->setSelectionMode(QAbstractItemView::SingleSelection);
+
+    m_empty->setWordWrap(true);
+    m_empty->setAlignment(Qt::AlignCenter);
+    m_empty->setText(i18n("No running terminals found.\nUse New to start one that keeps running when Konsole is closed."));
+    m_empty->hide();
+
+    m_newButton->setText(i18nc("@action:button", "New"));
+    m_newButton->setIcon(QIcon::fromTheme(QStringLiteral("list-add")));
+    m_newButton->setToolButtonStyle(Qt::ToolButtonTextBesideIcon);
+    m_newButton->setPopupMode(QToolButton::InstantPopup);
+    m_newButton->setMenu(new QMenu(m_newButton));
+
+    auto *refresh = new QToolButton(this);
+    refresh->setIcon(QIcon::fromTheme(QStringLiteral("view-refresh")));
+    refresh->setToolTip(i18nc("@info:tooltip", "Look for running terminals again"));
+    auto *addHostButton = new QToolButton(this);
+    addHostButton->setIcon(QIcon::fromTheme(QStringLiteral("network-server")));
+    addHostButton->setToolTip(i18nc("@info:tooltip", "Add another computer"));
+
+    auto *top = new QHBoxLayout;
+    auto *title = new QLabel(i18n("Running terminals"), this);
+    QFont titleFont = title->font();
+    titleFont.setBold(true);
+    title->setFont(titleFont);
+    top->addWidget(title, 1);
+    top->addWidget(addHostButton);
+    top->addWidget(refresh);
+
+    auto *bottom = new QHBoxLayout;
+    bottom->addWidget(m_openButton);
+    bottom->addWidget(m_openAllButton);
+    bottom->addWidget(m_newButton);
+
+    auto *layout = new QVBoxLayout(this);
+    layout->setContentsMargins(6, 6, 6, 6);
+    layout->addLayout(top);
+    layout->addWidget(m_view, 1);
+    layout->addWidget(m_empty);
+    layout->addLayout(bottom);
+
+    connect(refresh, &QToolButton::clicked, m_model, &MuxModel::refreshAll);
+    connect(addHostButton, &QToolButton::clicked, this, &MuxWidget::addHost);
+    connect(m_view, &QTreeView::customContextMenuRequested, this, &MuxWidget::showContextMenu);
+    connect(m_view->selectionModel(), &QItemSelectionModel::currentChanged, this, &MuxWidget::updateButtons);
+    connect(m_view, &QTreeView::doubleClicked, this, [this](const QModelIndex &index) {
+        const Selection s = selection(index);
+        if (s.isSession) {
+            Q_EMIT openRequested(s.hostId, s.session, false);
+        } else {
+            m_view->setExpanded(index, !m_view->isExpanded(index));
+        }
+    });
+    connect(m_openButton, &QPushButton::clicked, this, [this] {
+        const Selection s = selection(m_view->currentIndex());
+        if (s.isSession) {
+            Q_EMIT openRequested(s.hostId, s.session, false);
+        }
+    });
+    connect(m_openAllButton, &QPushButton::clicked, this, [this] {
+        const Selection s = selection(m_view->currentIndex());
+        if (!s.hostId.isEmpty()) {
+            Q_EMIT openAllRequested(s.hostId);
+        }
+    });
+    connect(m_model, &QAbstractItemModel::rowsInserted, this, [this](const QModelIndex &parent) {
+        if (!parent.isValid()) {
+            m_view->expandAll();
+        }
+        updateEmptyState();
+    });
+    connect(m_model, &QAbstractItemModel::modelReset, this, &MuxWidget::updateEmptyState);
+    connect(m_model, &QAbstractItemModel::rowsRemoved, this, &MuxWidget::updateEmptyState);
+    connect(m_model, &QAbstractItemModel::dataChanged, this, &MuxWidget::updateButtons);
+
+    m_view->expandAll();
+    updateButtons();
+}
+
+void MuxWidget::showEvent(QShowEvent *event)
+{
+    QWidget::showEvent(event);
+    m_model->refreshAll();
+}
+
+MuxWidget::Selection MuxWidget::selection(const QModelIndex &index) const
+{
+    Selection s;
+    if (!index.isValid()) {
+        return s;
+    }
+    s.hostId = index.data(MuxModel::HostIdRole).toString();
+    s.isSession = index.data(MuxModel::KindRole).toInt() == MuxModel::SessionKind;
+    if (s.isSession) {
+        s.session = index.data(MuxModel::SessionRole).value<Session>();
+    }
+    return s;
+}
+
+void MuxWidget::updateEmptyState()
+{
+    // Only the local machine and no sessions: say how to start.
+    bool any = false;
+    for (int row = 0; row < m_model->rowCount(); ++row) {
+        any = any || m_model->item(row)->rowCount() > 0;
+    }
+    m_empty->setVisible(!any);
+}
+
+void MuxWidget::updateButtons()
+{
+    const Selection s = selection(m_view->currentIndex());
+    m_openButton->setEnabled(s.isSession);
+    const MuxModel *model = m_model;
+    const bool hostHasSessions = !s.hostId.isEmpty() && !model->result(s.hostId).sessions.isEmpty();
+    m_openAllButton->setEnabled(hostHasSessions);
+    m_newButton->menu()->clear();
+    fillNewMenu(m_newButton->menu(), s.hostId);
+    m_newButton->setEnabled(!s.hostId.isEmpty() && !m_newButton->menu()->isEmpty());
+}
+
+void MuxWidget::fillNewMenu(QMenu *menu, const QString &hostId)
+{
+    if (hostId.isEmpty()) {
+        return;
+    }
+    // Only offer tools that exist on that machine.
+    const ProbeResult &r = m_model->result(hostId);
+    const auto add = [&](Tool tool, const QString &text) {
+        QAction *action = menu->addAction(QIcon::fromTheme(QStringLiteral("list-add")), text);
+        connect(action, &QAction::triggered, this, [this, hostId, tool] {
+            bool ok = false;
+            const QString name = QInputDialog::getText(this, i18n("New Running Terminal"), i18n("Name (optional):"), QLineEdit::Normal, QString(), &ok);
+            if (ok) {
+                Q_EMIT newRequested(hostId, tool, name.trimmed());
+            }
+        });
+    };
+    if (r.tmuxAvailable && r.screenAvailable) {
+        add(Tool::Tmux, i18nc("@action", "New (tmux)"));
+        add(Tool::Screen, i18nc("@action", "New (screen)"));
+    } else if (r.tmuxAvailable) {
+        add(Tool::Tmux, i18nc("@action", "New running terminal"));
+    } else if (r.screenAvailable) {
+        add(Tool::Screen, i18nc("@action", "New running terminal"));
+    }
+}
+
+void MuxWidget::showContextMenu(const QPoint &pos)
+{
+    const QModelIndex index = m_view->indexAt(pos);
+    const Selection s = selection(index);
+    if (s.hostId.isEmpty()) {
+        return;
+    }
+    QMenu menu(this);
+    if (s.isSession) {
+        menu.addAction(QIcon::fromTheme(QStringLiteral("media-playback-start")), i18n("Open in New Tab"), this, [this, s] {
+            Q_EMIT openRequested(s.hostId, s.session, false);
+        });
+        if (s.session.attached()) {
+            menu.addAction(QIcon::fromTheme(QStringLiteral("go-jump")), i18n("Move Here (disconnect other viewers)"), this, [this, s] {
+                Q_EMIT openRequested(s.hostId, s.session, true);
+            });
+            menu.addAction(QIcon::fromTheme(QStringLiteral("network-disconnect")), i18n("Disconnect Other Viewers"), this, [this, s] {
+                detachSession(s);
+            });
+        }
+        menu.addSeparator();
+        menu.addAction(QIcon::fromTheme(QStringLiteral("edit-rename")), i18n("Rename…"), this, [this, s] {
+            renameSession(s);
+        });
+        menu.addAction(QIcon::fromTheme(QStringLiteral("edit-delete")), i18n("End…"), this, [this, s] {
+            endSession(s);
+        });
+    } else {
+        QAction *all = menu.addAction(QIcon::fromTheme(QStringLiteral("view-restore")), i18n("Open All in Tabs"), this, [this, s] {
+            Q_EMIT openAllRequested(s.hostId);
+        });
+        all->setEnabled(!m_model->result(s.hostId).sessions.isEmpty());
+        QMenu *newMenu = menu.addMenu(QIcon::fromTheme(QStringLiteral("list-add")), i18n("New"));
+        fillNewMenu(newMenu, s.hostId);
+        newMenu->setEnabled(!newMenu->isEmpty());
+        menu.addAction(QIcon::fromTheme(QStringLiteral("view-refresh")), i18n("Refresh"), this, [this, s] {
+            m_model->refresh(s.hostId);
+        });
+        if (!m_model->host(s.hostId).isLocal()) {
+            menu.addSeparator();
+            menu.addAction(QIcon::fromTheme(QStringLiteral("list-remove")), i18n("Hide This Computer"), this, [this, s] {
+                m_model->hideHost(s.hostId);
+            });
+        }
+    }
+    menu.exec(m_view->viewport()->mapToGlobal(pos));
+}
+
+void MuxWidget::addHost()
+{
+    bool ok = false;
+    const QString destination =
+        QInputDialog::getText(this, i18n("Add Computer"), i18n("Computer to look at (for example name or user@name):"), QLineEdit::Normal, QString(), &ok);
+    if (ok) {
+        m_model->addManualHost(destination);
+    }
+}
+
+void MuxWidget::runOnHost(const Selection &selected, const QString &command)
+{
+    MuxProbe *probe = m_model->probe();
+    const MuxHost host = m_model->host(selected.hostId);
+    auto *connection = new QMetaObject::Connection;
+    *connection = connect(probe,
+                          &MuxProbe::commandFinished,
+                          this,
+                          [this, connection, hostId = selected.hostId](const QString &finishedHost, bool success, const QString &errorText) {
+                              if (finishedHost != hostId) {
+                                  return;
+                              }
+                              disconnect(*connection);
+                              delete connection;
+                              if (!success && !errorText.isEmpty()) {
+                                  KMessageBox::error(this, errorText, i18n("Running Terminals"));
+                              }
+                              m_model->refresh(hostId);
+                          });
+    probe->run(host, command);
+}
+
+void MuxWidget::renameSession(const Selection &selected)
+{
+    bool ok = false;
+    const QString name = QInputDialog::getText(this, i18n("Rename"), i18n("New name:"), QLineEdit::Normal, selected.session.name, &ok).trimmed();
+    if (ok && !name.isEmpty() && name != selected.session.name) {
+        runOnHost(selected, renameCommand(selected.session, name));
+    }
+}
+
+void MuxWidget::endSession(const Selection &selected)
+{
+    const QString text = i18n("End “%1”? Everything running in it will stop.", selected.session.name);
+    if (KMessageBox::warningContinueCancel(this, text, i18n("End Running Terminal"), KGuiItem(i18n("End"), QStringLiteral("edit-delete")))
+        == KMessageBox::Continue) {
+        runOnHost(selected, killCommand(selected.session));
+    }
+}
+
+void MuxWidget::detachSession(const Selection &selected)
+{
+    runOnHost(selected, detachCommand(selected.session));
+}
+
