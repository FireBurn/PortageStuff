 QString remoteTerminalCommand(const QStringList &sshArgs, const QString &command);
 
+/**
+ * The same, but started again by itself when the connection drops (ssh ends with 255, its code for a lost or
+ * refused connection), so a tab comes back to the same terminal. Any other ending, such as detaching or the
+ * program exiting, closes it. Five quick failures in a row stop it, so a wrong address does not loop for ever.
+ * @p stepSeconds is how much longer each attempt waits.
+ */
+QString reconnectingTerminalCommand(const QStringList &sshArgs, const QString &command, int stepSeconds = 3);
+
+/** The name to show for a session: a bare number is "tmux 3", anything else is its own name. */
+QString displayName(const Session &session);
+
 /** Arguments for a non-interactive ssh run of @p command, for background queries. */
 QStringList remoteQueryArguments(const QStringList &sshArgs, const QString &command, const QString &controlPath);
 }
