+void MultiplexerTest::namesShownToPeople()
+{
+    Session numbered;
+    numbered.tool = Tool::Tmux;
+    numbered.name = QStringLiteral("3");
+    QCOMPARE(displayName(numbered), QStringLiteral("tmux 3"));
+    Session named;
+    named.name = QStringLiteral("build");
+    QCOMPARE(displayName(named), QStringLiteral("build"));
+    Session screen;
+    screen.tool = Tool::Screen;
+    screen.name = QStringLiteral("12");
+    QCOMPARE(displayName(screen), QStringLiteral("screen 12"));
+}
+
+// Runs the generated script against a stand-in ssh, so the loop itself is what is tested.
+static int runReconnecting(const QString &fakeSsh, QString *output)
+{
+    QTemporaryDir dir;
+    QFile ssh(dir.filePath(QStringLiteral("ssh")));
+    ssh.open(QIODevice::WriteOnly);
+    ssh.write(fakeSsh.toUtf8());
+    ssh.close();
+    ssh.setPermissions(QFileDevice::ReadOwner | QFileDevice::WriteOwner | QFileDevice::ExeOwner);
+    QProcess shell;
+    QProcessEnvironment env = QProcessEnvironment::systemEnvironment();
+    env.insert(QStringLiteral("PATH"), dir.path() + QLatin1Char(':') + env.value(QStringLiteral("PATH")));
+    env.insert(QStringLiteral("STATE"), dir.filePath(QStringLiteral("count")));
+    shell.setProcessEnvironment(env);
+    const QString command = reconnectingTerminalCommand({QStringLiteral("me@quark")}, QStringLiteral("tmux attach-session -t '=a b'"), 0);
+    shell.start(QStringLiteral("sh"), {QStringLiteral("-c"), command});
+    shell.waitForFinished(20000);
+    *output = QString::fromUtf8(shell.readAllStandardOutput());
+    return shell.exitCode();
+}
+
+void MultiplexerTest::reconnectsAfterALostConnectionAndStopsAfterAnOrdinaryEnd()
+{
+    // Fails twice with 255 and then ends normally after being asked for the terminal.
+    QString output;
+    const int code = runReconnecting(QStringLiteral("#!/bin/sh\nn=$(cat \"$STATE\" 2>/dev/null || echo 0); n=$((n+1)); echo $n > \"$STATE\"\n"
+                                                    "[ $n -lt 3 ] && exit 255\necho \"args: $*\"\nexit 0\n"),
+                                     &output);
+    QCOMPARE(code, 0);
+    QCOMPARE(output.count(QStringLiteral("The connection dropped")), 2);
+    QVERIFY(output.contains(QStringLiteral("ServerAliveInterval=15")));
+    QVERIFY(output.contains(QStringLiteral("me@quark")));
+    QVERIFY(output.contains(QStringLiteral("tmux attach-session -t '=a b'")));
+}
+
+void MultiplexerTest::anOrdinaryExitIsPassedOnWithoutReconnecting()
+{
+    QString output;
+    QCOMPARE(runReconnecting(QStringLiteral("#!/bin/sh\nexit 7\n"), &output), 7);
+    QVERIFY(!output.contains(QStringLiteral("dropped")));
+}
+
+void MultiplexerTest::givesUpAfterFiveQuickFailures()
+{
+    QString output;
+    QCOMPARE(runReconnecting(QStringLiteral("#!/bin/sh\nexit 255\n"), &output), 255);
+    QVERIFY(output.contains(QStringLiteral("Giving up")));
+    QCOMPARE(output.count(QStringLiteral("The connection dropped")), 4);
+}
+
 QTEST_GUILESS_MAIN(MultiplexerTest)
 #include "MultiplexerTest.moc"
