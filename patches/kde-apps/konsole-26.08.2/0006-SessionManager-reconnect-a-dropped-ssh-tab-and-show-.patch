+QString reconnectingTerminalCommand(const QStringList &sshArgs, const QString &command, int stepSeconds)
+{
+    QStringList ssh{QStringLiteral("ssh"),
+                    QStringLiteral("-t"),
+                    QStringLiteral("-o"),
+                    QStringLiteral("ServerAliveInterval=15"),
+                    QStringLiteral("-o"),
+                    QStringLiteral("ServerAliveCountMax=3")};
+    for (const QString &arg : sshArgs) {
+        ssh.append(shellQuote(arg));
+    }
+    ssh.append(shellQuote(command));
+    const QString script = QStringLiteral(
+                               "fails=0; while :; do start=$(date +%s); %1; rc=$?;"
+                               " [ $rc -ne 255 ] && exit $rc;"
+                               " if [ $(( $(date +%s) - start )) -lt 5 ]; then fails=$((fails+1)); else fails=0; fi;"
+                               " if [ $fails -ge 5 ]; then echo; echo \"Could not connect. Giving up.\"; exit 255; fi;"
+                               " wait=$(((fails+1)*%2)); echo; echo \"The connection dropped. Reconnecting in ${wait}s. Press Ctrl+C to stop.\";"
+                               " sleep $wait; done")
+                               .arg(ssh.join(QLatin1Char(' ')))
+                               .arg(stepSeconds);
+    return QStringLiteral("sh -c ") + shellQuote(script);
+}
+
+QString displayName(const Session &session)
+{
+    static const QRegularExpression onlyDigits(QStringLiteral("^[0-9]+$"));
+    if (onlyDigits.match(session.name).hasMatch()) {
+        return toolName(session.tool) + QLatin1Char(' ') + session.name;
+    }
+    return session.name;
+}
