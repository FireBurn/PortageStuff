diff --git a/src/plugins/SessionManager/autotests/EdgePanelTest.cpp b/src/plugins/SessionManager/autotests/EdgePanelTest.cpp
new file mode 100644
index 000000000..c3c6a7883
--- /dev/null
+++ b/src/plugins/SessionManager/autotests/EdgePanelTest.cpp
@@ -0,0 +1,87 @@
+/*
+    SPDX-FileCopyrightText: 2026 Mike Lothian <mike@fireburn.co.uk>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include <QObject>
+#include <QTest>
+
+#include "../edgepanel.h"
+
+using namespace EdgePanel;
+
+class EdgePanelTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void theEdgeIsAlwaysAwayFromTheScrollBar();
+    void zonesAndPanelStayInsideTheArea();
+    void theShortCallToTheEdgeDoesNothing();
+    void stayingAtTheEdgeShowsThePanel();
+    void leavingHidesItAfterTheDelayButNotWhileInUse();
+    void goingBackBeforeTheDelayKeepsItUp();
+};
+
+void EdgePanelTest::theEdgeIsAlwaysAwayFromTheScrollBar()
+{
+    QCOMPARE(edgeFor(0), Edge::Left); // scroll bar on the right
+    QCOMPARE(edgeFor(1), Edge::Right); // scroll bar on the left
+    QCOMPARE(edgeFor(2), Edge::Left); // no scroll bar
+}
+
+void EdgePanelTest::zonesAndPanelStayInsideTheArea()
+{
+    const QRect area(0, 30, 1000, 600);
+    QCOMPARE(hotZone(area, Edge::Left, 6), QRect(0, 30, 6, 600));
+    QCOMPARE(hotZone(area, Edge::Right, 6), QRect(994, 30, 6, 600));
+    QCOMPARE(panelRect(area, Edge::Left, 320), QRect(0, 30, 320, 600));
+    QCOMPARE(panelRect(area, Edge::Right, 320), QRect(680, 30, 320, 600));
+    // A narrow window gets at most half of itself covered.
+    QCOMPARE(panelRect(QRect(0, 0, 400, 300), Edge::Left, 320).width(), 200);
+}
+
+void EdgePanelTest::theShortCallToTheEdgeDoesNothing()
+{
+    Visibility v(180, 700);
+    QVERIFY(!v.update(true, false, false, 0));
+    QVERIFY(!v.update(true, false, false, 100));
+    QVERIFY(!v.update(false, false, false, 120)); // left again
+    QVERIFY(!v.update(true, false, false, 130)); // the clock starts over
+    QVERIFY(!v.update(true, false, false, 300));
+}
+
+void EdgePanelTest::stayingAtTheEdgeShowsThePanel()
+{
+    Visibility v(180, 700);
+    QVERIFY(!v.update(true, false, false, 0));
+    QVERIFY(v.update(true, false, false, 180));
+    QVERIFY(v.visible());
+}
+
+void EdgePanelTest::leavingHidesItAfterTheDelayButNotWhileInUse()
+{
+    Visibility v(100, 700);
+    v.update(true, false, false, 0);
+    QVERIFY(v.update(true, false, false, 100));
+    QVERIFY(v.update(false, true, false, 200)); // moved onto the panel
+    QVERIFY(v.update(false, false, false, 300)); // left it
+    QVERIFY(v.update(false, false, false, 900)); // 600 ms: still up
+    QVERIFY(v.update(false, false, true, 5000)); // a menu is open: stays
+    QVERIFY(v.update(false, false, false, 5100));
+    QVERIFY(!v.update(false, false, false, 5800)); // 700 ms after the menu closed
+}
+
+void EdgePanelTest::goingBackBeforeTheDelayKeepsItUp()
+{
+    Visibility v(100, 700);
+    v.show(0);
+    QVERIFY(v.update(false, false, false, 100));
+    QVERIFY(v.update(false, true, false, 600));
+    QVERIFY(v.update(false, false, false, 700));
+    QVERIFY(v.update(false, false, false, 1300));
+    QVERIFY(!v.update(false, false, false, 1400));
+}
+
+QTEST_GUILESS_MAIN(EdgePanelTest)
+#include "EdgePanelTest.moc"
diff --git a/src/plugins/SessionManager/autotests/MuxOverlayTest.cpp b/src/plugins/SessionManager/autotests/MuxOverlayTest.cpp
new file mode 100644
index 000000000..3d2944620
--- /dev/null
+++ b/src/plugins/SessionManager/autotests/MuxOverlayTest.cpp
@@ -0,0 +1,142 @@
+/*
+    SPDX-FileCopyrightText: 2026 Mike Lothian <mike@fireburn.co.uk>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include <QApplication>
+#include <QDir>
+#include <QLabel>
+#include <QMainWindow>
+#include <QStandardPaths>
+#include <QTemporaryDir>
+#include <QTest>
+
+#include "../muxmodel.h"
+#include "../muxoverlay.h"
+#include "../muxwidget.h"
+
+class MuxOverlayTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void initTestCase();
+    void appearsAtTheEdgeAwayFromTheScrollBarWithoutResizingTheTerminal();
+    void staysAwayFromTheScrollBarSide();
+    void hidesWhenThePointerLeavesAndNotBefore();
+    void escapeClosesItAndSwitchingOffKeepsItClosed();
+
+private:
+    QTemporaryDir m_home;
+};
+
+void MuxOverlayTest::initTestCase()
+{
+    // The list asks the computers in ssh config what they are running, which a test must not do.
+    QStandardPaths::setTestModeEnabled(true);
+    qputenv("HOME", m_home.path().toUtf8());
+    qputenv("PATH", "/nonexistent");
+}
+
+namespace
+{
+struct Fixture {
+    QMainWindow window;
+    QLabel *terminal = new QLabel(QStringLiteral("terminal"));
+    MuxModel model;
+    QPoint pointer{500, 300};
+    int scrollBar = 0;
+    MuxEdgeOverlay *overlay = nullptr;
+
+    Fixture()
+    {
+        window.setCentralWidget(terminal);
+        window.resize(900, 600);
+        window.show();
+        QTest::qWaitForWindowExposed(&window);
+        window.activateWindow();
+        QTest::qWait(50);
+        overlay = new MuxEdgeOverlay(
+            &window,
+            &model,
+            [this] {
+                return scrollBar;
+            },
+            [this] {
+                return window.mapToGlobal(pointer);
+            });
+    }
+
+    // Puts the pointer on the left or right edge of the terminal and waits for the delay.
+    void goToEdge(bool left)
+    {
+        const QRect area(terminal->mapTo(&window, QPoint(0, 0)), terminal->size());
+        pointer = QPoint(left ? area.left() + 1 : area.right() - 1, area.center().y());
+        QTest::qWait(400);
+    }
+};
+}
+
+void MuxOverlayTest::appearsAtTheEdgeAwayFromTheScrollBarWithoutResizingTheTerminal()
+{
+    Fixture f;
+    const QSize before = f.terminal->size();
+    QVERIFY(!f.overlay->isShown());
+    f.goToEdge(true);
+    QVERIFY(f.overlay->isShown());
+    QCOMPARE(f.terminal->size(), before); // nothing is resized as it comes and goes
+    const QWidget *panel = f.overlay->widget()->parentWidget();
+    QCOMPARE(panel->geometry().left(), f.terminal->mapTo(&f.window, QPoint(0, 0)).x());
+    QVERIFY(panel->width() > 150 && panel->width() <= f.terminal->width() / 2);
+    const QString shot = qEnvironmentVariable("MUX_SHOT");
+    if (!shot.isEmpty()) {
+        f.window.grab().save(shot);
+    }
+}
+
+void MuxOverlayTest::staysAwayFromTheScrollBarSide()
+{
+    Fixture f;
+    f.scrollBar = 0; // scroll bar on the right
+    // The right edge, where the scroll bar is, does nothing.
+    f.goToEdge(false);
+    QVERIFY(!f.overlay->isShown());
+    f.scrollBar = 1; // scroll bar on the left: now the right edge is the one
+    f.goToEdge(false);
+    QVERIFY(f.overlay->isShown());
+    const QWidget *panel = f.overlay->widget()->parentWidget();
+    QCOMPARE(panel->geometry().right(), f.terminal->mapTo(&f.window, QPoint(0, 0)).x() + f.terminal->width() - 1);
+}
+
+void MuxOverlayTest::hidesWhenThePointerLeavesAndNotBefore()
+{
+    Fixture f;
+    f.goToEdge(true);
+    QVERIFY(f.overlay->isShown());
+    f.pointer = QPoint(100, 300); // onto the panel
+    QTest::qWait(900);
+    QVERIFY(f.overlay->isShown());
+    f.pointer = QPoint(700, 300); // out over the terminal
+    QTest::qWait(300);
+    QVERIFY(f.overlay->isShown()); // not at once
+    QTest::qWait(900);
+    QVERIFY(!f.overlay->isShown());
+}
+
+void MuxOverlayTest::escapeClosesItAndSwitchingOffKeepsItClosed()
+{
+    Fixture f;
+    f.goToEdge(true);
+    QVERIFY(f.overlay->isShown());
+    QTest::keyClick(f.overlay->widget()->parentWidget(), Qt::Key_Escape);
+    QVERIFY(!f.overlay->isShown());
+    f.overlay->setAutoHide(false);
+    f.goToEdge(true);
+    QVERIFY(!f.overlay->isShown());
+    f.overlay->setAutoHide(true);
+    f.goToEdge(true);
+    QVERIFY(f.overlay->isShown());
+}
+
+QTEST_MAIN(MuxOverlayTest)
+#include "MuxOverlayTest.moc"
