+static Konsole::Session *sessionAt(Konsole::TabbedViewContainer *container, int index)
+{
+    auto *splitter = qobject_cast<Konsole::ViewSplitter *>(container->widget(index));
+    Konsole::TerminalDisplay *display = splitter ? splitter->activeTerminalDisplay() : nullptr;
+    return display ? display->session().data() : nullptr;
+}
+
+void SessionManagerPlugin::watchTabBar(QTabBar *bar, Konsole::MainWindow *mainWindow)
+{
+    if (bar->property(watchedProperty).toBool()) {
+        return;
+    }
+    bar->setProperty(watchedProperty, true);
+    // A tab the user drags stays where they put it; the rest sort around it.
+    connect(bar, &QTabBar::tabMoved, this, [this, mainWindow](int, int to) {
+        if (m_arranging) {
+            return;
+        }
+        Konsole::TabbedViewContainer *container = mainWindow->viewManager()->activeContainer();
+        if (Konsole::Session *session = container ? sessionAt(container, to) : nullptr) {
+            if (!session->property(keyProperty).toString().isEmpty()) {
+                session->setProperty(manualProperty, true);
+            }
+        }
+    });
+}
+
+void SessionManagerPlugin::organiseTabs(Konsole::MainWindow *mainWindow)
+{
+    Konsole::TabbedViewContainer *container = mainWindow->viewManager()->activeContainer();
+    QTabBar *bar = container ? container->findChild<QTabBar *>() : nullptr;
+    if (!bar) {
+        return;
+    }
+    watchTabBar(bar, mainWindow);
+
+    QList<TabOrder::Tab> tabs;
+    QList<Konsole::Session *> sessions;
+    for (int i = 0; i < container->count(); ++i) {
+        Konsole::Session *session = sessionAt(container, i);
+        sessions.append(session);
+        TabOrder::Tab tab;
+        const QStringList parts = session ? session->property(keyProperty).toString().split(QLatin1Char('\n')) : QStringList();
+        if (parts.size() >= 3) {
+            tab.managed = true;
+            tab.manual = session->property(manualProperty).toBool();
+            tab.group = 0;
+            for (int h = 0; h < m_model->hosts().size(); ++h) {
+                if (m_model->hosts().at(h).id == parts.at(0)) {
+                    tab.group = h;
+                    break;
+                }
+            }
+            tab.tool = parts.at(1) == toolName(Tool::Screen) ? 1 : 0;
+            tab.name = parts.mid(2).join(QLatin1Char('\n'));
+            tab.created = session->property(openedProperty).toLongLong();
+        }
+        tabs.append(tab);
+    }
+
+    // arrange() says which tab belongs in each place; move them there one at a time.
+    const QList<int> wanted = TabOrder::arrange(tabs);
+    QList<int> current;
+    for (int i = 0; i < tabs.size(); ++i) {
+        current.append(i);
+    }
+    m_arranging = true;
+    for (int slot = 0; slot < wanted.size(); ++slot) {
+        const int from = current.indexOf(wanted.at(slot));
+        if (from != slot) {
+            bar->moveTab(from, slot);
+            current.move(from, slot);
+        }
+    }
+    m_arranging = false;
+
+    // Every group has its own colour, so tabs from one computer are easy to find. Applied after the moves,
+    // by the place each tab ended up in.
+    for (int slot = 0; slot < wanted.size(); ++slot) {
+        const TabOrder::Tab &tab = tabs.at(wanted.at(slot));
+        if (tab.managed) {
+            container->setColor(slot, TabOrder::groupColour(tab.group));
+        }
+    }
+}
