@@ -0,0 +1,87 @@
+/*
+    SPDX-FileCopyrightText: 2026 Mike Lothian <mike@fireburn.co.uk>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include <QObject>
+#include <QTest>
+
+#include "../taborder.h"
+
+using namespace TabOrder;
+
+class TabOrderTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void thisComputerFirstThenOthersThenToolThenName();
+    void namesSortNumbersByValue();
+    void tabsNotOpenedFromThePanelKeepTheirPlace();
+    void tabsMovedByHandKeepTheirPlaceAndOthersFlowAround();
+    void anOrderedBarIsLeftAlone();
+    void groupColoursAreDistinctForNeighbouringGroups();
+};
+
+static Tab tab(int group, int tool, const QString &name, bool managed = true, bool manual = false, qint64 created = 0)
+{
+    Tab t;
+    t.group = group;
+    t.tool = tool;
+    t.name = name;
+    t.managed = managed;
+    t.manual = manual;
+    t.created = created;
+    return t;
+}
+
+void TabOrderTest::thisComputerFirstThenOthersThenToolThenName()
+{
+    const QList<Tab> tabs{tab(2, 0, QStringLiteral("a")),
+                          tab(0, 1, QStringLiteral("z")),
+                          tab(1, 0, QStringLiteral("b")),
+                          tab(0, 0, QStringLiteral("y")),
+                          tab(0, 0, QStringLiteral("a"))};
+    // local tmux a, local tmux y, local screen z, then computer 1, then computer 2
+    QCOMPARE(arrange(tabs), (QList<int>{4, 3, 1, 2, 0}));
+}
+
+void TabOrderTest::namesSortNumbersByValue()
+{
+    const QList<Tab> tabs{tab(0, 0, QStringLiteral("10")), tab(0, 0, QStringLiteral("2")), tab(0, 0, QStringLiteral("Build")), tab(0, 0, QStringLiteral("1"))};
+    QCOMPARE(arrange(tabs), (QList<int>{3, 1, 0, 2}));
+    QVERIFY(naturalLess(QStringLiteral("a2"), QStringLiteral("a10")));
+    QVERIFY(!naturalLess(QStringLiteral("B"), QStringLiteral("a")));
+}
+
+void TabOrderTest::tabsNotOpenedFromThePanelKeepTheirPlace()
+{
+    // A plain shell in the middle stays at index 1.
+    const QList<Tab> tabs{tab(1, 0, QStringLiteral("r")), tab(0, 0, QStringLiteral("shell"), false), tab(0, 0, QStringLiteral("l"))};
+    QCOMPARE(arrange(tabs), (QList<int>{2, 1, 0}));
+}
+
+void TabOrderTest::tabsMovedByHandKeepTheirPlaceAndOthersFlowAround()
+{
+    // The last tab was dragged to the front by hand; the other two sort around it.
+    const QList<Tab> tabs{tab(0, 0, QStringLiteral("a"), true, true), tab(1, 0, QStringLiteral("b")), tab(0, 0, QStringLiteral("c"))};
+    QCOMPARE(arrange(tabs), (QList<int>{0, 2, 1}));
+}
+
+void TabOrderTest::anOrderedBarIsLeftAlone()
+{
+    const QList<Tab> tabs{tab(0, 0, QStringLiteral("a")), tab(0, 0, QStringLiteral("b")), tab(1, 0, QStringLiteral("a"))};
+    QCOMPARE(arrange(tabs), (QList<int>{0, 1, 2}));
+    QCOMPARE(arrange({}), QList<int>());
+}
+
+void TabOrderTest::groupColoursAreDistinctForNeighbouringGroups()
+{
+    for (int g = 0; g < 5; ++g) {
+        QVERIFY(groupColour(g) != groupColour(g + 1));
+    }
+    QCOMPARE(groupColour(0), groupColour(6));
+}
+
+QTEST_GUILESS_MAIN(TabOrderTest)
+#include "TabOrderTest.moc"
diff --git a/src/plugins/SessionManager/edgepanel.cpp b/src/plugins/SessionManager/edgepanel.cpp
new file mode 100644
index 000000000..ffe4ca144
--- /dev/null
+++ b/src/plugins/SessionManager/edgepanel.cpp
@@ -0,0 +1,79 @@
+/*
+    SPDX-FileCopyrightText: 2026 Mike Lothian <mike@fireburn.co.uk>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "edgepanel.h"
+
+namespace EdgePanel
+{
+Edge edgeFor(int scrollBarPosition)
+{
+    return scrollBarPosition == 1 ? Edge::Right : Edge::Left;
+}
+
+QRect hotZone(const QRect &area, Edge edge, int width)
+{
+    return edge == Edge::Left ? QRect(area.left(), area.top(), width, area.height()) : QRect(area.right() - width + 1, area.top(), width, area.height());
+}
+
+QRect panelRect(const QRect &area, Edge edge, int width)
+{
+    const int w = qMin(width, area.width() / 2);
+    return edge == Edge::Left ? QRect(area.left(), area.top(), w, area.height()) : QRect(area.right() - w + 1, area.top(), w, area.height());
+}
+
+Visibility::Visibility(int showDelayMs, int hideDelayMs)
+    : m_showDelay(showDelayMs)
+    , m_hideDelay(hideDelayMs)
+{
+}
+
+bool Visibility::visible() const
+{
+    return m_visible;
+}
+
+void Visibility::show(qint64 nowMs)
+{
+    m_visible = true;
+    m_awaySince = nowMs;
+    m_hotSince = -1;
+}
+
+void Visibility::hide()
+{
+    m_visible = false;
+    m_hotSince = -1;
+    m_awaySince = -1;
+}
+
+bool Visibility::update(bool inHotZone, bool inPanel, bool busy, qint64 nowMs)
+{
+    if (!m_visible) {
+        if (inHotZone) {
+            if (m_hotSince < 0) {
+                m_hotSince = nowMs;
+            }
+            if (nowMs - m_hotSince >= m_showDelay) {
+                show(nowMs);
+            }
+        } else {
+            m_hotSince = -1;
+        }
+        return m_visible;
+    }
+    if (inPanel || inHotZone || busy) {
+        m_awaySince = -1;
+    } else {
+        if (m_awaySince < 0) {
+            m_awaySince = nowMs;
+        }
+        if (nowMs - m_awaySince >= m_hideDelay) {
+            hide();
+        }
+    }
+    return m_visible;
+}
+}
diff --git a/src/plugins/SessionManager/edgepanel.h b/src/plugins/SessionManager/edgepanel.h
new file mode 100644
index 000000000..58dd852a2
--- /dev/null
+++ b/src/plugins/SessionManager/edgepanel.h
@@ -0,0 +1,56 @@
+/*
+    SPDX-FileCopyrightText: 2026 Mike Lothian <mike@fireburn.co.uk>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#ifndef EDGEPANEL_H
+#define EDGEPANEL_H
+
+#include <QPoint>
+#include <QRect>
+
+/**
+ * A panel that slides over the terminal when the pointer reaches one edge of the window and goes again when it
+ * leaves. It never takes space from the terminal, so nothing is resized as it comes and goes, and it uses the
+ * edge away from the scroll bar so the scroll bar is never covered.
+ */
+namespace EdgePanel
+{
+enum class Edge {
+    Left,
+    Right,
+};
+
+/** The edge away from the scroll bar. @p scrollBarPosition is Konsole's: 0 right, 1 left, 2 hidden. */
+Edge edgeFor(int scrollBarPosition);
+
+/** A thin strip along the edge where the pointer calls the panel up. */
+QRect hotZone(const QRect &area, Edge edge, int width);
+
+/** Where the panel sits when it is shown. */
+QRect panelRect(const QRect &area, Edge edge, int width);
+
+/** Decides, from the pointer and a clock, when the panel is shown. Nothing here reads the pointer or a timer. */
+class Visibility
+{
+public:
+    Visibility(int showDelayMs = 180, int hideDelayMs = 700);
+
+    /** @p busy is true while a menu or dialog from the panel is open, which keeps it up. */
+    bool update(bool inHotZone, bool inPanel, bool busy, qint64 nowMs);
+
+    bool visible() const;
+    void show(qint64 nowMs);
+    void hide();
+
+private:
+    int m_showDelay;
+    int m_hideDelay;
+    bool m_visible = false;
+    qint64 m_hotSince = -1;
+    qint64 m_awaySince = -1;
+};
+}
+
+#endif
diff --git a/src/plugins/SessionManager/muxoverlay.cpp b/src/plugins/SessionManager/muxoverlay.cpp
new file mode 100644
index 000000000..448fb07c4
--- /dev/null
+++ b/src/plugins/SessionManager/muxoverlay.cpp
@@ -0,0 +1,147 @@
+/*
+    SPDX-FileCopyrightText: 2026 Mike Lothian <mike@fireburn.co.uk>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "muxoverlay.h"
+
+#include "muxmodel.h"
+#include "muxwidget.h"
+
+#include <QApplication>
+#include <QCursor>
+#include <QEvent>
+#include <QKeyEvent>
+#include <QMainWindow>
+#include <QTimer>
+#include <QVBoxLayout>
+
+namespace
+{
+constexpr int hotZoneWidth = 4;
+}
+
+MuxEdgeOverlay::MuxEdgeOverlay(QMainWindow *window, MuxModel *model, std::function<int()> scrollBarPosition, std::function<QPoint()> pointer)
+    : QObject(window)
+    , m_window(window)
+    , m_scrollBarPosition(std::move(scrollBarPosition))
+    , m_pointer(std::move(pointer))
+    , m_panel(new QFrame(window))
+    , m_widget(new MuxWidget(model, m_panel))
+    , m_timer(new QTimer(this))
+{
+    m_widget->setPinnable(true);
+    m_panel->setFrameShape(QFrame::StyledPanel);
+    m_panel->setAutoFillBackground(true);
+    m_panel->hide();
+    auto *layout = new QVBoxLayout(m_panel);
+    layout->setContentsMargins(0, 0, 0, 0);
+    layout->addWidget(m_widget);
+    m_panel->installEventFilter(this);
+    window->installEventFilter(this);
+
+    m_clock.start();
+    m_timer->setInterval(60);
+    connect(m_timer, &QTimer::timeout, this, &MuxEdgeOverlay::poll);
+    m_timer->start();
+}
+
+MuxWidget *MuxEdgeOverlay::widget() const
+{
+    return m_widget;
+}
+
+bool MuxEdgeOverlay::autoHide() const
+{
+    return m_autoHide;
+}
+
+void MuxEdgeOverlay::setAutoHide(bool enabled)
+{
+    m_autoHide = enabled;
+    if (!enabled) {
+        m_visibility.hide();
+        poll();
+    }
+}
+
+void MuxEdgeOverlay::setSuspended(bool suspended)
+{
+    m_suspended = suspended;
+    if (suspended) {
+        m_visibility.hide();
+        poll();
+    }
+}
+
+void MuxEdgeOverlay::reveal()
+{
+    if (m_suspended) {
+        return;
+    }
+    m_visibility.show(m_clock.elapsed());
+    poll();
+}
+
+bool MuxEdgeOverlay::isShown() const
+{
+    return m_panel->isVisible();
+}
+
+QRect MuxEdgeOverlay::area() const
+{
+    QWidget *central = m_window->centralWidget();
+    return QRect(central->mapTo(m_window, QPoint(0, 0)), central->size());
+}
+
+EdgePanel::Edge MuxEdgeOverlay::edge() const
+{
+    return EdgePanel::edgeFor(m_scrollBarPosition());
+}
+
+void MuxEdgeOverlay::place()
+{
+    const int width = m_window->fontMetrics().horizontalAdvance(QLatin1Char('M')) * 38;
+    m_panel->setGeometry(EdgePanel::panelRect(area(), edge(), width));
+}
+
+void MuxEdgeOverlay::poll()
+{
+    const bool usable = m_autoHide && !m_suspended && m_window->isActiveWindow();
+    bool shown = false;
+    if (usable || (m_panel->isVisible() && m_visibility.visible() && !m_suspended && m_autoHide)) {
+        const QPoint pointer = m_window->mapFromGlobal(m_pointer());
+        const bool hot = usable && EdgePanel::hotZone(area(), edge(), hotZoneWidth).contains(pointer);
+        const bool inPanel = m_panel->isVisible() && m_panel->geometry().contains(pointer);
+        // A menu or dialog opened from the panel keeps it up.
+        const bool busy = QApplication::activePopupWidget() != nullptr || QApplication::activeModalWidget() != nullptr;
+        shown = m_visibility.update(hot, inPanel, busy, m_clock.elapsed());
+    } else {
+        m_visibility.hide();
+    }
+    if (shown != m_panel->isVisible()) {
+        if (shown) {
+            place();
+        }
+        m_panel->setVisible(shown);
+        if (shown) {
+            m_panel->raise();
+        }
+        Q_EMIT shownChanged(shown);
+    }
+}
+
+bool MuxEdgeOverlay::eventFilter(QObject *watched, QEvent *event)
+{
+    if (watched == m_window && (event->type() == QEvent::Resize || event->type() == QEvent::Show) && m_panel->isVisible()) {
+        place();
+    } else if (watched == m_panel && event->type() == QEvent::KeyPress && static_cast<QKeyEvent *>(event)->key() == Qt::Key_Escape) {
+        m_visibility.hide();
+        poll();
+        return true;
+    }
+    return QObject::eventFilter(watched, event);
+}
