+/*
+    SPDX-FileCopyrightText: 2026 Mike Lothian <mike@fireburn.co.uk>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#ifndef TABORDER_H
+#define TABORDER_H
+
+#include <QColor>
+#include <QList>
+#include <QString>
+
+/**
+ * Where tabs opened from Running Terminals go on the tab bar: grouped by computer, this one first, then tmux
+ * before screen, then by name. Tabs the user moved by hand and tabs not opened from the panel keep their place.
+ */
+namespace TabOrder
+{
+struct Tab {
+    bool managed = false; // opened from Running Terminals
+    bool manual = false; // moved by hand, so left where it is
+    int group = 0; // 0 is this computer, then each other computer in the order the panel lists them
+    int tool = 0; // 0 tmux, 1 screen
+    QString name;
+    qint64 created = 0;
+};
+
+/** The original positions, in the order the tabs should now be in. */
+QList<int> arrange(const QList<Tab> &tabs);
+
+/** 2 sorts before 10, and case is ignored. */
+bool naturalLess(const QString &a, const QString &b);
+
+/** A colour for a group of tabs. They stay apart for the common kinds of colour blindness. */
+QColor groupColour(int group);
+}
+
+#endif
