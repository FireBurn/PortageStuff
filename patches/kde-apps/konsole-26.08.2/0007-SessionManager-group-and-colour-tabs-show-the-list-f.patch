+/*
+    SPDX-FileCopyrightText: 2026 Mike Lothian <mike@fireburn.co.uk>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "taborder.h"
+
+#include <QCollator>
+
+#include <algorithm>
+
+namespace TabOrder
+{
+bool naturalLess(const QString &a, const QString &b)
+{
+    QCollator collator;
+    collator.setNumericMode(true);
+    collator.setCaseSensitivity(Qt::CaseInsensitive);
+    return collator.compare(a, b) < 0;
+}
+
+QList<int> arrange(const QList<Tab> &tabs)
+{
+    const int count = tabs.size();
+    QList<int> result(count, -1);
+    QList<int> movable;
+    for (int i = 0; i < count; ++i) {
+        if (tabs.at(i).managed && !tabs.at(i).manual) {
+            movable.append(i);
+        } else {
+            result[i] = i;
+        }
+    }
+    std::stable_sort(movable.begin(), movable.end(), [&tabs](int x, int y) {
+        const Tab &a = tabs.at(x);
+        const Tab &b = tabs.at(y);
+        if (a.group != b.group) {
+            return a.group < b.group;
+        }
+        if (a.tool != b.tool) {
+            return a.tool < b.tool;
+        }
+        if (a.name != b.name) {
+            return naturalLess(a.name, b.name);
+        }
+        return a.created < b.created;
+    });
+    int next = 0;
+    for (int slot = 0; slot < count; ++slot) {
+        if (result.at(slot) < 0) {
+            result[slot] = movable.at(next++);
+        }
+    }
+    return result;
+}
+
+QColor groupColour(int group)
+{
+    // Okabe and Ito's set, without the yellow that would vanish on a light tab bar.
+    static const QColor colours[] = {QColor(0x00, 0x72, 0xB2),
+                                     QColor(0xE6, 0x9F, 0x00),
+                                     QColor(0x00, 0x9E, 0x73),
+                                     QColor(0xCC, 0x79, 0xA7),
+                                     QColor(0xD5, 0x5E, 0x00),
+                                     QColor(0x56, 0xB4, 0xE9)};
+    return colours[qAbs(group) % 6];
+}
+}
