+/**
+ * Running Terminals as a panel that appears over the terminal when the pointer reaches the edge of the window,
+ * on the side away from the scroll bar, and goes away again when the pointer leaves. It does not take space from
+ * the terminal, so nothing is resized as it comes and goes, and the pointer is watched on a timer, so the edge
+ * stays usable for the terminal and the scroll bar.
+ */
+class MuxEdgeOverlay : public QObject
+{
+    Q_OBJECT
+public:
+    /**
+     * @p scrollBarPosition says where the terminal's scroll bar is (0 right, 1 left, 2 hidden) and @p pointer gives
+     * the pointer in screen coordinates. Both are parameters so that the panel does not depend on Konsole.
+     */
+    MuxEdgeOverlay(
+        QMainWindow *window,
+        MuxModel *model,
+        std::function<int()> scrollBarPosition,
+        std::function<QPoint()> pointer = [] {
+            return QCursor::pos();
+        });
+
+    MuxWidget *widget() const;
+    bool autoHide() const;
+    void setAutoHide(bool enabled);
+    /** True while something else already shows the list, such as the side dock. */
+    void setSuspended(bool suspended);
+    /** Shows the panel now, as if the pointer had stayed at the edge. */
+    void reveal();
+    bool isShown() const;
+
+Q_SIGNALS:
+    void shownChanged(bool shown);
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override;
+
+private:
+    void poll();
+    void place();
+    QRect area() const;
+    EdgePanel::Edge edge() const;
+
+    QMainWindow *m_window;
+    std::function<int()> m_scrollBarPosition;
+    std::function<QPoint()> m_pointer;
+    QFrame *m_panel;
+    MuxWidget *m_widget;
+    QTimer *m_timer;
+    QElapsedTimer m_clock;
+    EdgePanel::Visibility m_visibility;
+    bool m_autoHide = true;
+    bool m_suspended = false;
+};
+
+#endif
