+++ b/src/plugins/SessionManager/multiplexer.h
@@ -0,0 +1,78 @@
+/*
+    SPDX-FileCopyrightText: 2026 Mike Lothian <mike@fireburn.co.uk>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#ifndef MULTIPLEXER_H
+#define MULTIPLEXER_H
+
+#include <QDateTime>
+#include <QList>
+#include <QString>
+#include <QStringList>
+
+/**
+ * Parsing of tmux and GNU screen output and construction of the shell
+ * commands that act on their sessions. Nothing here starts a process, so the
+ * same text works for local and remote (ssh) hosts and can be unit tested.
+ */
+namespace Multiplexer
+{
+enum class Tool {
+    Tmux,
+    Screen,
+};
+
+struct Session {
+    Tool tool = Tool::Tmux;
+    // Name for tmux, "pid.name" for screen. Identifies the session on its host.
+    QString id;
+    QString name;
+    int windows = 0; // 0 when the tool does not report it
+    int clients = 0; // number of attached clients, 0 for tmux when detached
+    QDateTime created;
+    QString command; // program running in the active window, when the tool reports it
+
+    bool attached() const
+    {
+        return clients > 0;
+    }
+    bool operator==(const Session &other) const = default;
+};
+
+struct ProbeResult {
+    bool tmuxAvailable = false;
+    bool screenAvailable = false;
+    QList<Session> sessions;
+};
+
+QString toolName(Tool tool);
+QString shellQuote(const QString &text);
+
+/** Shell command that prints the output understood by parseProbeOutput(). */
+QString probeCommand();
+
+ProbeResult parseProbeOutput(const QString &output);
+QList<Session> parseTmux(const QString &output);
+QList<Session> parseScreen(const QString &output);
+
+/** Commands for a session. They are plain shell text, to be run on the host that owns the session. */
+QString attachCommand(const Session &session, bool takeOver = false);
+QString newSessionCommand(Tool tool, const QString &name);
+QString killCommand(const Session &session);
+QString detachCommand(const Session &session);
+// Empty when the tool cannot rename a session without being attached to it.
+QString renameCommand(const Session &session, const QString &newName);
+
+/**
+ * Wraps a command so that it runs on the host reached with @p sshArgs. The
+ * result is a single shell command line that starts ssh with a terminal.
+ */
+QString remoteTerminalCommand(const QStringList &sshArgs, const QString &command);
+
+/** Arguments for a non-interactive ssh run of @p command, for background queries. */
+QStringList remoteQueryArguments(const QStringList &sshArgs, const QString &command, const QString &controlPath);
+}
+
+#endif
