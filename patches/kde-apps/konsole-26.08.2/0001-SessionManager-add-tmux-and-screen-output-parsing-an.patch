+/*
+    SPDX-FileCopyrightText: 2026 Mike Lothian <mike@fireburn.co.uk>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include <QTest>
+
+#include "../multiplexer.h"
+
+using namespace Multiplexer;
+
+class MultiplexerTest : public QObject
+{
+    Q_OBJECT
+private Q_SLOTS:
+    void parseTmux();
+    void parseTmuxNameWithSeparator();
+    void parseTmuxIgnoresNoise();
+    void parseScreen();
+    void parseScreenIgnoresDeadAndNoise();
+    void parseProbe();
+    void parseProbeNothingInstalled();
+    void commands();
+    void remoteCommands();
+};
+
+void MultiplexerTest::parseTmux()
+{
+    const auto sessions = Multiplexer::parseTmux(QStringLiteral("$0|3|1|1760000000|vim|work\n$4|1|0|1760000100|bash|logs\n"));
+    QCOMPARE(sessions.size(), 2);
+    QCOMPARE(sessions[0].tool, Tool::Tmux);
+    QCOMPARE(sessions[0].id, QStringLiteral("work"));
+    QCOMPARE(sessions[0].windows, 3);
+    QCOMPARE(sessions[0].command, QStringLiteral("vim"));
+    QVERIFY(sessions[0].attached());
+    QCOMPARE(sessions[0].created.toSecsSinceEpoch(), 1760000000);
+    QVERIFY(!sessions[1].attached());
+}
+
+void MultiplexerTest::parseTmuxNameWithSeparator()
+{
+    const auto sessions = Multiplexer::parseTmux(QStringLiteral("$1|2|0|1760000000|sh|a|b\n"));
+    QCOMPARE(sessions.size(), 1);
+    QCOMPARE(sessions[0].name, QStringLiteral("a|b"));
+}
+
+void MultiplexerTest::parseTmuxIgnoresNoise()
+{
+    QVERIFY(Multiplexer::parseTmux(QStringLiteral("no server running on /tmp/tmux-1000/default\n\nfoo|bar\n$x|1|0|0|sh|name\n")).isEmpty());
+}
+
+void MultiplexerTest::parseScreen()
+{
+    const QString output = QStringLiteral(
+        "There are screens on:\n"
+        "\t1234.build\t(10/15/2026 01:02:03 AM)\t(Detached)\n"
+        "\t5678.my shell\t(10/15/2026 02:00:00 PM)\t(Attached)\n"
+        "2 Sockets in /run/screen/S-user.\n");
+    const auto sessions = Multiplexer::parseScreen(output);
+    QCOMPARE(sessions.size(), 2);
+    QCOMPARE(sessions[0].id, QStringLiteral("1234.build"));
+    QCOMPARE(sessions[0].name, QStringLiteral("build"));
+    QVERIFY(!sessions[0].attached());
+    QVERIFY(sessions[0].created.isValid());
+    QCOMPARE(sessions[1].name, QStringLiteral("my shell"));
+    QVERIFY(sessions[1].attached());
+    QCOMPARE(sessions[1].created.time().hour(), 14);
+}
+
+void MultiplexerTest::parseScreenIgnoresDeadAndNoise()
+{
+    const QString output = QStringLiteral(
+        "There is a screen on:\n"
+        "\t99.gone\t(10/15/2026 01:02:03 AM)\t(Dead ?\?\?)\n"
+        "No Sockets found in /run/screen/S-user.\n");
+    QVERIFY(Multiplexer::parseScreen(output).isEmpty());
+}
+
+void MultiplexerTest::parseProbe()
+{
+    const QString output = QStringLiteral(
+        "@tmux\n$0|1|0|1760000000|sh|work\n"
+        "@screen\nThere is a screen on:\n\t42.old\t(10/15/2026 01:02:03 AM)\t(Multi, attached)\n1 Socket in /run/screen/S-u.\n");
+    const ProbeResult result = parseProbeOutput(output);
+    QVERIFY(result.tmuxAvailable);
+    QVERIFY(result.screenAvailable);
+    QCOMPARE(result.sessions.size(), 2);
+    QCOMPARE(result.sessions[0].tool, Tool::Tmux);
+    QCOMPARE(result.sessions[1].tool, Tool::Screen);
+    QVERIFY(result.sessions[1].attached());
+}
+
+void MultiplexerTest::parseProbeNothingInstalled()
+{
+    const ProbeResult result = parseProbeOutput(QString());
+    QVERIFY(!result.tmuxAvailable);
+    QVERIFY(!result.screenAvailable);
+    QVERIFY(result.sessions.isEmpty());
+}
+
+void MultiplexerTest::commands()
+{
+    Session tmux;
+    tmux.tool = Tool::Tmux;
+    tmux.id = tmux.name = QStringLiteral("it's");
+    QCOMPARE(attachCommand(tmux), QStringLiteral("tmux attach-session -t '=it'\\''s'"));
+    QCOMPARE(attachCommand(tmux, true), QStringLiteral("tmux attach-session -d -t '=it'\\''s'"));
+    QCOMPARE(killCommand(tmux), QStringLiteral("tmux kill-session -t '=it'\\''s'"));
+    QCOMPARE(renameCommand(tmux, QStringLiteral("new")), QStringLiteral("tmux rename-session -t '=it'\\''s' 'new'"));
+
+    Session screen;
+    screen.tool = Tool::Screen;
+    screen.id = QStringLiteral("12.job");
+    QCOMPARE(attachCommand(screen), QStringLiteral("screen -r '12.job'"));
+    screen.clients = 1;
+    QCOMPARE(attachCommand(screen), QStringLiteral("screen -x '12.job'"));
+    QCOMPARE(attachCommand(screen, true), QStringLiteral("screen -d -r '12.job'"));
+    QCOMPARE(killCommand(screen), QStringLiteral("screen -S '12.job' -X quit"));
+
+    QCOMPARE(newSessionCommand(Tool::Tmux, QString()), QStringLiteral("tmux new-session"));
+    QCOMPARE(newSessionCommand(Tool::Screen, QStringLiteral("a b")), QStringLiteral("screen -S 'a b'"));
+}
+
+void MultiplexerTest::remoteCommands()
+{
+    QCOMPARE(remoteTerminalCommand({QStringLiteral("-p"), QStringLiteral("2222"), QStringLiteral("me@quark")}, QStringLiteral("tmux attach-session -t '=a b'")),
+             QStringLiteral("ssh -t '-p' '2222' 'me@quark' 'tmux attach-session -t '\\''=a b'\\'''"));
+
+    const QStringList args = remoteQueryArguments({QStringLiteral("quark")}, QStringLiteral("true"), QStringLiteral("/tmp/cp-%C"));
+    QVERIFY(args.contains(QStringLiteral("BatchMode=yes")));
+    QVERIFY(args.contains(QStringLiteral("ControlPath=/tmp/cp-%C")));
+    QCOMPARE(args.last(), QStringLiteral("true"));
+    QCOMPARE(args.at(args.size() - 2), QStringLiteral("quark"));
+}
+
+QTEST_GUILESS_MAIN(MultiplexerTest)
+#include "MultiplexerTest.moc"
diff --git a/src/plugins/SessionManager/multiplexer.cpp b/src/plugins/SessionManager/multiplexer.cpp
new file mode 100644
index 000000000..34a87dbef
--- /dev/null
+++ b/src/plugins/SessionManager/multiplexer.cpp
@@ -0,0 +1,211 @@
+/*
+    SPDX-FileCopyrightText: 2026 Mike Lothian <mike@fireburn.co.uk>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "multiplexer.h"
+
+#include <QRegularExpression>
+
+namespace Multiplexer
+{
+QString toolName(Tool tool)
+{
+    return tool == Tool::Tmux ? QStringLiteral("tmux") : QStringLiteral("screen");
+}
+
+QString shellQuote(const QString &text)
+{
+    QString quoted = text;
+    quoted.replace(QLatin1Char('\''), QStringLiteral("'\\''"));
+    return QLatin1Char('\'') + quoted + QLatin1Char('\'');
+}
+
+static QString stripControl(const QString &text)
+{
+    QString out;
+    for (const QChar c : text) {
+        if (c.unicode() >= 32 && c.unicode() != 127) {
+            out.append(c);
+        }
+    }
+    return out.trimmed();
+}
+
+QString probeCommand()
+{
+    // Only double quotes and no variables, so that it survives any login shell
+    // (fish, csh and so on) once wrapped in sh -c '...'.
+    const QString script = QStringLiteral(
+        "if command -v tmux >/dev/null 2>&1; then echo @tmux;"
+        " tmux list-sessions -F \"#{session_id}|#{session_windows}|#{session_attached}|#{session_created}|#{pane_current_command}|#{session_name}\" "
+        "2>/dev/null; fi;"
+        " if command -v screen >/dev/null 2>&1; then echo @screen; screen -ls 2>/dev/null; fi; true");
+    return QStringLiteral("sh -c ") + shellQuote(script);
+}
+
+QList<Session> parseTmux(const QString &output)
+{
+    QList<Session> sessions;
+    const auto lines = output.split(QLatin1Char('\n'));
+    for (const QString &line : lines) {
+        // The name comes last because it may itself contain the separator.
+        const QStringList fields = line.split(QLatin1Char('|'));
+        static const QRegularExpression tmuxId(QStringLiteral("^\\$[0-9]+$"));
+        if (fields.size() < 6 || !tmuxId.match(fields.at(0)).hasMatch()) {
+            continue;
+        }
+        bool windowsOk = false;
+        bool attachedOk = false;
+        const int windows = fields.at(1).toInt(&windowsOk);
+        const int attached = fields.at(2).toInt(&attachedOk);
+        if (!windowsOk || !attachedOk) {
+            continue;
+        }
+        Session session;
+        session.tool = Tool::Tmux;
+        session.name = stripControl(fields.mid(5).join(QLatin1Char('|')));
+        if (session.name.isEmpty()) {
+            continue;
+        }
+        session.id = session.name;
+        session.windows = windows;
+        session.command = stripControl(fields.at(4));
+        session.clients = attached;
+        const qint64 created = fields.at(3).toLongLong();
+        if (created > 0) {
+            session.created = QDateTime::fromSecsSinceEpoch(created);
+        }
+        sessions.append(session);
+    }
+    return sessions;
+}
+
+QList<Session> parseScreen(const QString &output)
+{
+    static const QRegularExpression entry(
+        QStringLiteral("^\\s*(\\d+)\\.(\\S.*?)\\s+(?:\\(([^()]*)\\)\\s+)?\\((Attached|Detached|Multi, attached|Multi, detached)\\)\\s*$"));
+
+    QList<Session> sessions;
+    const auto lines = output.split(QLatin1Char('\n'));
+    for (const QString &line : lines) {
+        const QRegularExpressionMatch match = entry.match(line);
+        if (!match.hasMatch()) {
+            continue;
+        }
+        Session session;
+        session.tool = Tool::Screen;
+        session.name = stripControl(match.captured(2));
+        session.id = match.captured(1) + QLatin1Char('.') + session.name;
+        const QString status = match.captured(4);
+        session.clients = (status == QLatin1String("Attached") || status == QLatin1String("Multi, attached")) ? 1 : 0;
+        const QString date = match.captured(3);
+        if (!date.isEmpty()) {
+            for (const QString &format : {QStringLiteral("MM/dd/yyyy hh:mm:ss AP"),
+                                          QStringLiteral("MM/dd/yy hh:mm:ss AP"),
+                                          QStringLiteral("MM/dd/yyyy HH:mm:ss"),
+                                          QStringLiteral("dd/MM/yyyy HH:mm:ss")}) {
+                session.created = QDateTime::fromString(date, format);
+                if (session.created.isValid()) {
+                    break;
+                }
+            }
+        }
+        sessions.append(session);
+    }
+    return sessions;
+}
+
+ProbeResult parseProbeOutput(const QString &output)
+{
+    ProbeResult result;
+    QString tmuxPart;
+    QString screenPart;
+    QString *current = nullptr;
+    const auto lines = output.split(QLatin1Char('\n'));
+    for (const QString &line : lines) {
+        if (line == QLatin1String("@tmux")) {
+            result.tmuxAvailable = true;
+            current = &tmuxPart;
+        } else if (line == QLatin1String("@screen")) {
+            result.screenAvailable = true;
+            current = &screenPart;
+        } else if (current) {
+            current->append(line + QLatin1Char('\n'));
+        }
+    }
+    result.sessions = parseTmux(tmuxPart) + parseScreen(screenPart);
+    return result;
+}
+
+QString attachCommand(const Session &session, bool takeOver)
+{
+    if (session.tool == Tool::Tmux) {
+        return QStringLiteral("tmux attach-session %1-t %2").arg(takeOver ? QStringLiteral("-d ") : QString(), shellQuote(QLatin1Char('=') + session.id));
+    }
+    // -x shares a session that is attached elsewhere, -d -r moves it here.
+    const QString mode = takeOver ? QStringLiteral("-d -r") : (session.attached() ? QStringLiteral("-x") : QStringLiteral("-r"));
+    return QStringLiteral("screen %1 %2").arg(mode, shellQuote(session.id));
+}
+
+QString newSessionCommand(Tool tool, const QString &name)
+{
+    if (tool == Tool::Tmux) {
+        return name.isEmpty() ? QStringLiteral("tmux new-session") : QStringLiteral("tmux new-session -s %1").arg(shellQuote(name));
+    }
+    return name.isEmpty() ? QStringLiteral("screen") : QStringLiteral("screen -S %1").arg(shellQuote(name));
+}
+
+QString killCommand(const Session &session)
+{
+    if (session.tool == Tool::Tmux) {
+        return QStringLiteral("tmux kill-session -t %1").arg(shellQuote(QLatin1Char('=') + session.id));
+    }
+    return QStringLiteral("screen -S %1 -X quit").arg(shellQuote(session.id));
+}
+
+QString detachCommand(const Session &session)
+{
+    if (session.tool == Tool::Tmux) {
+        return QStringLiteral("tmux detach-client -s %1").arg(shellQuote(QLatin1Char('=') + session.id));
+    }
+    return QStringLiteral("screen -S %1 -X detach").arg(shellQuote(session.id));
+}
+
+QString renameCommand(const Session &session, const QString &newName)
+{
+    if (session.tool == Tool::Tmux) {
+        return QStringLiteral("tmux rename-session -t %1 %2").arg(shellQuote(QLatin1Char('=') + session.id), shellQuote(newName));
+    }
+    return QStringLiteral("screen -S %1 -X sessionname %2").arg(shellQuote(session.id), shellQuote(newName));
+}
+
+QString remoteTerminalCommand(const QStringList &sshArgs, const QString &command)
+{
+    QStringList parts{QStringLiteral("ssh"), QStringLiteral("-t")};
+    for (const QString &arg : sshArgs) {
+        parts.append(shellQuote(arg));
+    }
+    parts.append(shellQuote(command));
+    return parts.join(QLatin1Char(' '));
+}
+
+QStringList remoteQueryArguments(const QStringList &sshArgs, const QString &command, const QString &controlPath)
+{
+    QStringList args{QStringLiteral("-o"),
+                     QStringLiteral("BatchMode=yes"),
+                     QStringLiteral("-o"),
+                     QStringLiteral("ConnectTimeout=8"),
+                     QStringLiteral("-o"),
+                     QStringLiteral("ControlMaster=auto"),
+                     QStringLiteral("-o"),
+                     QStringLiteral("ControlPersist=120"),
+                     QStringLiteral("-o"),
+                     QStringLiteral("ControlPath=") + controlPath,
+                     QStringLiteral("-T")};
+    args += sshArgs;
+    args.append(command);
+    return args;
+}
+}
diff --git a/src/plugins/SessionManager/multiplexer.h b/src/plugins/SessionManager/multiplexer.h
new file mode 100644
index 000000000..6ee03b26f
