From 8a656c24c01e584e576415fc056bd8ee4bc5392a Mon Sep 17 00:00:00 2001
From: Mike Lothian <mike@fireburn.co.uk>
Date: Thu, 4 Dec 2025 00:15:15 +0000
Subject: [PATCH] Fix

---
 daemon/actions/bundled/handlebuttonevents.cpp       | 13 ++++++++++++-
 daemon/controllers/keyboardbrightnesscontroller.cpp | 10 ++++++++--
 2 files changed, 20 insertions(+), 3 deletions(-)

diff --git a/daemon/actions/bundled/handlebuttonevents.cpp b/daemon/actions/bundled/handlebuttonevents.cpp
index 14f351d7..cf981c11 100644
--- a/daemon/actions/bundled/handlebuttonevents.cpp
+++ b/daemon/actions/bundled/handlebuttonevents.cpp
@@ -142,9 +142,20 @@ void HandleButtonEvents::onWakeupFromIdle()
 void HandleButtonEvents::onLidClosedChanged(bool closed)
 {
     if (closed) {
+        // Ensure we capture the current brightness before turning it off
+        const int currentBrightness = core()->keyboardBrightnessController()->brightness();
+        if (currentBrightness > 0) {
+            m_oldKeyboardBrightness = currentBrightness;
+        }
+
+        // Delay the brightness turn-off to avoid races with firmware/EC logic triggered by lid close
         if (m_oldKeyboardBrightness.has_value()) {
-            core()->keyboardBrightnessController()->setBrightness(0);
+            QTimer::singleShot(1000, this, [this] {
+                core()->keyboardBrightnessController()->setBrightness(0);
+            });
         }
+	core()->keyboardBrightnessController()->setBrightness(0);
+	core()->keyboardBrightnessController()->setBrightness(0);
 
         if (!m_screenConfiguration) {
             // triggering the lid closed action now might suspend the system even though it just started up
diff --git a/daemon/controllers/keyboardbrightnesscontroller.cpp b/daemon/controllers/keyboardbrightnesscontroller.cpp
index 345b89fd..6a489eab 100644
--- a/daemon/controllers/keyboardbrightnesscontroller.cpp
+++ b/daemon/controllers/keyboardbrightnesscontroller.cpp
@@ -90,7 +90,13 @@ void KeyboardBrightnessController::setBrightness(int value)
         m_brightnessBeforeTogglingOff = brightness();
     }
     qCDebug(POWERDEVIL) << "set kbd backlight value: " << value;
-    m_kbdBacklight->SetBrightness(value);
+    auto reply = m_kbdBacklight->SetBrightness(value);
+    reply.waitForFinished();
+    if (reply.isError()) {
+        qCWarning(POWERDEVIL) << "SetBrightness failed:" << reply.error().message();
+    } else {
+        qCDebug(POWERDEVIL) << "SetBrightness finished successfully";
+    }
     if (value > 0) {
         m_brightnessBeforeTogglingOff = brightness();
     }
@@ -145,7 +151,7 @@ int KeyboardBrightnessController::toggleBacklight()
 
 void KeyboardBrightnessController::onBrightnessChanged(int value, const QString &source)
 {
-    qCDebug(POWERDEVIL) << "Keyboard brightness changed!!";
+    qCDebug(POWERDEVIL) << "Keyboard brightness changed to" << value << "from" << source;
     if (value != m_cachedBrightness) {
         m_cachedBrightness = value;
         // source: internal = keyboard brightness changed through hardware, eg a firmware-handled hotkey being pressed -> show the OSD
-- 
