         if (std::holds_alternative<GLTexture *>(renderNode.texture)) {
             const auto texture = std::get<GLTexture *>(renderNode.texture);
             glActiveTexture(GL_TEXTURE0);
-            shader->setUniform("converter", 0);
             texture->bind();
