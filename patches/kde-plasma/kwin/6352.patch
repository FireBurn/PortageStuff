 src/backends/drm/drm_qpainter_layer.h         |  1 +
 src/core/colorspace.cpp                       | 53 ++++++++++++++++---
 src/core/colorspace.h                         | 22 ++++++--
 src/opengl/glshader.cpp                       |  1 +
 src/opengl/glshader.h                         |  1 +
 src/opengl/glshadermanager.cpp                | 18 ++-----
