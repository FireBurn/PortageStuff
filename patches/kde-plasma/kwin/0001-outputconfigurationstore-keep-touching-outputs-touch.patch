+// The logical (i.e. post-scale) size of an output, as it would end up after applying "change".
+// Used for anchor point math, where positions are always in logical coordinates.
+static QSize effectiveLogicalSize(OutputChangeSet *change, BackendOutput *output)
+{
+    const QSize pixelSize = calculatePixelSize(change, output);
+    const double scale = change->scale.value_or(change->scaleSetting.value_or(output->scale()));
+    if (scale <= 0) {
+        return pixelSize;
+    }
+    return QSize(std::ceil(pixelSize.width() / scale), std::ceil(pixelSize.height() / scale));
+}
+
+namespace
+{
+
+using AnchorEdge = OutputConfigurationStore::AnchorEdge;
+using OutputAnchor = OutputConfigurationStore::OutputAnchor;
+
+// The offset of an AnchorEdge point from an output's top-left corner, for a given logical size.
+QPoint anchorEdgeOffset(AnchorEdge edge, const QSize &size)
+{
+    switch (edge) {
+    case AnchorEdge::TopLeft:
+        return QPoint(0, 0);
+    case AnchorEdge::TopCenter:
+        return QPoint(size.width() / 2, 0);
+    case AnchorEdge::TopRight:
+        return QPoint(size.width(), 0);
+    case AnchorEdge::LeftCenter:
+        return QPoint(0, size.height() / 2);
+    case AnchorEdge::RightCenter:
+        return QPoint(size.width(), size.height() / 2);
+    case AnchorEdge::BottomLeft:
+        return QPoint(0, size.height());
+    case AnchorEdge::BottomCenter:
+        return QPoint(size.width() / 2, size.height());
+    case AnchorEdge::BottomRight:
+        return QPoint(size.width(), size.height());
+    }
+    Q_UNREACHABLE();
+}
+
+QPoint anchorEdgeCoordinate(AnchorEdge edge, const QPoint &pos, const QSize &size)
+{
+    return pos + anchorEdgeOffset(edge, size);
+}
+
+QPoint topLeftFromAnchorPoint(AnchorEdge edge, const QPoint &coordinate, const QSize &size)
+{
+    return coordinate - anchorEdgeOffset(edge, size);
+}
+
+constexpr int s_anchorEpsilon = 2;
+
+struct AnchorEdgePair
+{
+    AnchorEdge selfEdge;
+    AnchorEdge targetEdge;
+};
+
+// If "self" is touching "target" (within s_anchorEpsilon) on one of its four sides, returns the
+// anchor describing self's position relative to target, choosing whichever of the three
+// alignment variants for that side (corner/corner, center/center, or the opposite corner pair)
+// leaves the smallest residual offset. That residual is the deliberate "offset" a user's
+// arrangement might have (e.g. two side-by-side monitors that aren't top-aligned).
+std::optional<OutputAnchor> detectPairAnchor(const QPoint &selfPos, const QSize &selfSize,
+                                             const QPoint &targetPos, const QSize &targetSize,
+                                             size_t targetOutputIndex)
+{
+    if (selfSize.isEmpty() || targetSize.isEmpty()) {
+        return std::nullopt;
+    }
+    const int selfRight = selfPos.x() + selfSize.width();
+    const int selfBottom = selfPos.y() + selfSize.height();
+    const int targetRight = targetPos.x() + targetSize.width();
+    const int targetBottom = targetPos.y() + targetSize.height();
+
+    static const std::array<AnchorEdgePair, 3> s_selfRightOfTarget{{
+        {AnchorEdge::TopLeft, AnchorEdge::TopRight},
+        {AnchorEdge::LeftCenter, AnchorEdge::RightCenter},
+        {AnchorEdge::BottomLeft, AnchorEdge::BottomRight},
+    }};
+    static const std::array<AnchorEdgePair, 3> s_selfLeftOfTarget{{
+        {AnchorEdge::TopRight, AnchorEdge::TopLeft},
+        {AnchorEdge::RightCenter, AnchorEdge::LeftCenter},
+        {AnchorEdge::BottomRight, AnchorEdge::BottomLeft},
+    }};
+    static const std::array<AnchorEdgePair, 3> s_selfBelowTarget{{
+        {AnchorEdge::TopLeft, AnchorEdge::BottomLeft},
+        {AnchorEdge::TopCenter, AnchorEdge::BottomCenter},
+        {AnchorEdge::TopRight, AnchorEdge::BottomRight},
+    }};
+    static const std::array<AnchorEdgePair, 3> s_selfAboveTarget{{
+        {AnchorEdge::BottomLeft, AnchorEdge::TopLeft},
+        {AnchorEdge::BottomCenter, AnchorEdge::TopCenter},
+        {AnchorEdge::BottomRight, AnchorEdge::TopRight},
+    }};
+
+    const std::array<AnchorEdgePair, 3> *variants = nullptr;
+    if (std::abs(selfPos.x() - targetRight) <= s_anchorEpsilon) {
+        variants = &s_selfRightOfTarget;
+    } else if (std::abs(selfRight - targetPos.x()) <= s_anchorEpsilon) {
+        variants = &s_selfLeftOfTarget;
+    } else if (std::abs(selfPos.y() - targetBottom) <= s_anchorEpsilon) {
+        variants = &s_selfBelowTarget;
+    } else if (std::abs(selfBottom - targetPos.y()) <= s_anchorEpsilon) {
+        variants = &s_selfAboveTarget;
+    } else {
+        return std::nullopt;
+    }
+
+    std::optional<OutputAnchor> best;
+    int bestMagnitude = std::numeric_limits<int>::max();
+    for (const auto &variant : *variants) {
+        const QPoint selfCoord = anchorEdgeCoordinate(variant.selfEdge, selfPos, selfSize);
+        const QPoint targetCoord = anchorEdgeCoordinate(variant.targetEdge, targetPos, targetSize);
+        const QPoint offset = selfCoord - targetCoord;
+        const int magnitude = std::abs(offset.x()) + std::abs(offset.y());
+        if (magnitude < bestMagnitude) {
+            bestMagnitude = magnitude;
+            best = OutputAnchor{
+                .targetOutputIndex = targetOutputIndex,
+                .selfPoint = variant.selfEdge,
+                .targetPoint = variant.targetEdge,
+                .offset = offset,
+            };
+        }
+    }
+    return best;
+}
