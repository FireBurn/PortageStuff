+QSize OutputConfigurationStore::outputLogicalSize(const OutputState &state) const
+{
+    if (!state.mode) {
+        return QSize();
+    }
+    const QSize modeSize = state.mode->size();
+    const auto transform = state.transform.value_or(OutputTransform::Kind::Normal);
+    const QSize pixelSize = transform.map(modeSize);
+    const double scale = state.scaleSetting.value_or(1.0);
+    if (scale <= 0) {
+        return pixelSize;
+    }
+    return QSize(std::ceil(pixelSize.width() / scale), std::ceil(pixelSize.height() / scale));
+}
+
+void OutputConfigurationStore::detectAnchors(Setup &setup) const
+{
+    struct Node
+    {
+        size_t stateIndex; // index into setup.outputs
+        QPoint position;
+        QSize size;
+    };
+    QList<Node> nodes;
+    for (size_t i = 0; i < size_t(setup.outputs.size()); i++) {
+        SetupState &state = setup.outputs[i];
+        state.anchor.reset();
+        if (!state.enabled || state.outputIndex >= size_t(m_outputs.size())) {
+            continue;
+        }
+        const QSize size = outputLogicalSize(m_outputs[state.outputIndex]);
+        if (size.isEmpty()) {
+            continue;
+        }
+        nodes.push_back(Node{.stateIndex = i, .position = state.position, .size = size});
+    }
+    if (nodes.size() < 2) {
+        return;
+    }
+
+    // for every touching pair, each side's own anchor (used if the OTHER side ends up being
+    // its parent in the tree built below)
+    QList<QList<std::pair<size_t, OutputAnchor>>> neighbours(nodes.size());
+    for (size_t i = 0; i < size_t(nodes.size()); i++) {
+        for (size_t j = i + 1; j < size_t(nodes.size()); j++) {
+            const auto anchorIfJIsParent = detectPairAnchor(nodes[i].position, nodes[i].size, nodes[j].position, nodes[j].size, setup.outputs[nodes[j].stateIndex].outputIndex);
+            const auto anchorIfIIsParent = detectPairAnchor(nodes[j].position, nodes[j].size, nodes[i].position, nodes[i].size, setup.outputs[nodes[i].stateIndex].outputIndex);
+            if (anchorIfJIsParent && anchorIfIIsParent) {
+                neighbours[i].push_back({j, *anchorIfJIsParent});
+                neighbours[j].push_back({i, *anchorIfIIsParent});
+            }
+        }
+    }
+
+    // process components in top-left-most-first order, so the result is deterministic and the
+    // most top-left output of each connected group of touching outputs becomes its root
+    QList<size_t> order(nodes.size());
+    std::iota(order.begin(), order.end(), 0);
+    std::ranges::sort(order, [&nodes](size_t a, size_t b) {
+        return std::make_tuple(nodes[a].position.x(), nodes[a].position.y()) < std::make_tuple(nodes[b].position.x(), nodes[b].position.y());
+    });
+
+    QList<bool> visited(nodes.size(), false);
+    for (const size_t start : order) {
+        if (visited[start]) {
+            continue;
+        }
+        visited[start] = true;
+        QList<size_t> queue{start};
+        while (!queue.isEmpty()) {
+            const size_t current = queue.takeFirst();
+            for (const auto &[neighbourIdx, anchorIfParent] : neighbours[current]) {
+                if (visited[neighbourIdx]) {
+                    continue;
+                }
+                visited[neighbourIdx] = true;
+                setup.outputs[nodes[neighbourIdx].stateIndex].anchor = anchorIfParent;
+                queue.push_back(neighbourIdx);
+            }
+        }
+    }
+}
+
+void OutputConfigurationStore::resolveAnchoredPositions(OutputConfiguration &config, const QList<BackendOutput *> &outputs, bool isLidClosed)
+{
+    const auto opt = findSetup(outputs, isLidClosed);
+    if (!opt) {
+        // no exact match for the currently connected outputs -> nothing stored to anchor from
+        return;
+    }
+    resolveAnchoredPositions(config, opt->setup->outputs, opt->globalOutputIndices, /* onlyIfPosUnset= */ true);
+}
+
+void OutputConfigurationStore::resolveAnchoredPositions(OutputConfiguration &config, const QList<SetupState> &knownStates, const std::unordered_map<BackendOutput *, size_t> &outputMap, bool onlyIfPosUnset) const
+{
+    if (knownStates.isEmpty()) {
+        return;
+    }
+    std::unordered_map<size_t, BackendOutput *> byIndex;
+    byIndex.reserve(outputMap.size());
+    for (const auto &[output, index] : outputMap) {
+        byIndex[index] = output;
+    }
+
+    QList<bool> resolved(knownStates.size(), false);
+    for (int i = 0; i < knownStates.size(); i++) {
+        const auto &anchor = knownStates[i].anchor;
+        const auto selfIt = byIndex.find(knownStates[i].outputIndex);
+        if (!anchor || !byIndex.contains(anchor->targetOutputIndex)) {
+            resolved[i] = true;
+        } else if (onlyIfPosUnset && selfIt != byIndex.end()) {
+            const auto existing = config.constChangeSet(selfIt->second);
+            if (existing && existing->pos.has_value()) {
+                resolved[i] = true;
+            }
+        }
+    }
+
+    bool progress = true;
+    for (int pass = 0; progress && pass <= knownStates.size(); pass++) {
+        progress = false;
+        for (int i = 0; i < knownStates.size(); i++) {
+            if (resolved[i]) {
+                continue;
+            }
+            const SetupState &state = knownStates[i];
+            const int targetLocalIndex = std::find_if(knownStates.begin(), knownStates.end(), [&state](const SetupState &other) {
+                return other.outputIndex == state.anchor->targetOutputIndex;
+            }) - knownStates.begin();
+            if (targetLocalIndex >= knownStates.size() || !resolved[targetLocalIndex]) {
+                continue;
+            }
+            const auto selfIt = byIndex.find(state.outputIndex);
+            if (selfIt == byIndex.end()) {
+                resolved[i] = true;
+                progress = true;
+                continue;
+            }
+            BackendOutput *const selfOutput = selfIt->second;
+            BackendOutput *const targetOutput = byIndex.at(state.anchor->targetOutputIndex);
+            const auto targetChangeset = config.changeSet(targetOutput);
+            const QPoint targetPos = targetChangeset->pos.value_or(targetOutput->position());
+            const QSize targetSize = effectiveLogicalSize(targetChangeset.get(), targetOutput);
+            const auto selfChangeset = config.changeSet(selfOutput);
+            const QSize selfSize = effectiveLogicalSize(selfChangeset.get(), selfOutput);
+            const QPoint targetCoord = anchorEdgeCoordinate(state.anchor->targetPoint, targetPos, targetSize);
+            const QPoint selfCoord = targetCoord + state.anchor->offset;
+            selfChangeset->pos = topLeftFromAnchorPoint(state.anchor->selfPoint, selfCoord, selfSize);
+            resolved[i] = true;
+            progress = true;
+        }
+    }
+    if (!std::ranges::all_of(resolved, std::identity{})) {
+        qCDebug(KWIN_OUTPUT_CONFIG, "Could not resolve every anchored output position (cycle in stored config?); leaving the affected outputs at their previous position");
+    }
+}
