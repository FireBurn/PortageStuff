+static QString anchorEdgeToString(OutputConfigurationStore::AnchorEdge edge)
+{
+    switch (edge) {
+    case OutputConfigurationStore::AnchorEdge::TopLeft:
+        return QStringLiteral("topLeft");
+    case OutputConfigurationStore::AnchorEdge::TopCenter:
+        return QStringLiteral("topCenter");
+    case OutputConfigurationStore::AnchorEdge::TopRight:
+        return QStringLiteral("topRight");
+    case OutputConfigurationStore::AnchorEdge::LeftCenter:
+        return QStringLiteral("leftCenter");
+    case OutputConfigurationStore::AnchorEdge::RightCenter:
+        return QStringLiteral("rightCenter");
+    case OutputConfigurationStore::AnchorEdge::BottomLeft:
+        return QStringLiteral("bottomLeft");
+    case OutputConfigurationStore::AnchorEdge::BottomCenter:
+        return QStringLiteral("bottomCenter");
+    case OutputConfigurationStore::AnchorEdge::BottomRight:
+        return QStringLiteral("bottomRight");
+    }
+    Q_UNREACHABLE();
+}
+
+static std::optional<OutputConfigurationStore::AnchorEdge> anchorEdgeFromString(const QString &str)
+{
+    using AnchorEdge = OutputConfigurationStore::AnchorEdge;
+    if (str == "topLeft") {
+        return AnchorEdge::TopLeft;
+    } else if (str == "topCenter") {
+        return AnchorEdge::TopCenter;
+    } else if (str == "topRight") {
+        return AnchorEdge::TopRight;
+    } else if (str == "leftCenter") {
+        return AnchorEdge::LeftCenter;
+    } else if (str == "rightCenter") {
+        return AnchorEdge::RightCenter;
+    } else if (str == "bottomLeft") {
+        return AnchorEdge::BottomLeft;
+    } else if (str == "bottomCenter") {
+        return AnchorEdge::BottomCenter;
+    } else if (str == "bottomRight") {
+        return AnchorEdge::BottomRight;
+    }
+    return std::nullopt;
+}
