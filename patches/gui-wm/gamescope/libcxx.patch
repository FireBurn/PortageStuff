diff -urN a/src/atomic_shared_ptr.h b/src/atomic_shared_ptr.h
--- a/src/atomic_shared_ptr.h
+++ b/src/atomic_shared_ptr.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <atomic>
+#include <memory>
+
+// libc++ has no std::atomic<std::shared_ptr<T>>
+#if defined(__cpp_lib_atomic_shared_ptr)
+template <typename T>
+using atomic_shared_ptr = std::atomic<std::shared_ptr<T>>;
+#else
+template <typename T>
+class atomic_shared_ptr
+{
+public:
+	atomic_shared_ptr() = default;
+	atomic_shared_ptr( std::nullptr_t ) {}
+	atomic_shared_ptr( std::shared_ptr<T> p ) : m_p( std::move( p ) ) {}
+
+	void store( std::shared_ptr<T> p, std::memory_order = std::memory_order_seq_cst )
+	{
+		std::atomic_store( &m_p, std::move( p ) );
+	}
+
+	std::shared_ptr<T> load( std::memory_order = std::memory_order_seq_cst ) const
+	{
+		return std::atomic_load( &m_p );
+	}
+
+	operator std::shared_ptr<T>() const { return load(); }
+
+	atomic_shared_ptr &operator=( std::nullptr_t )
+	{
+		store( nullptr );
+		return *this;
+	}
+
+	atomic_shared_ptr &operator=( std::shared_ptr<T> p )
+	{
+		store( std::move( p ) );
+		return *this;
+	}
+
+private:
+	std::shared_ptr<T> m_p;
+};
+#endif
