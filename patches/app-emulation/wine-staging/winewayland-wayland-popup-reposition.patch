From: Michael Lothian <mike@fireburn.co.uk>
Subject: [PATCH] winewayland.drv: Place the tray menu above the icon.

Wayland has no work area, so a menu opened near the panel was put at the
click and pushed against the screen edge. Centre it on the icon, above
it (below for a panel at the top) and clear of the screen edges. The click
is passed to the process that opens the menu in a property of the desktop
window.

Show the last frame of a window once its configure has been processed. A
frame that was drawn before is dropped, and a menu that has not changed
is not drawn again, so it stayed invisible.

---
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -933,6 +933,81 @@
 }
 
 /**********************************************************************
+ *          wayland_surface_place_popup
+ *
+ * Moves the menu opened by a tray icon click above (or below, for a top
+ * panel) the icon, centred on it and away from the screen edges, so that it
+ * clears the panel as it does with a work area.
+ */
+static void wayland_surface_place_popup(struct wayland_surface *surface, RECT *rect)
+{
+    const int margin = 12, gap = 44;
+    int width = rect->right - rect->left, height = rect->bottom - rect->top;
+    struct wayland_output *output;
+    ULONG_PTR click;
+    int click_x, click_y;
+
+    TRACE("hwnd=%p rect=%s\n", surface->hwnd, wine_dbgstr_rect(rect));
+    TRACE("hwnd=%p rect=%s\n", surface->hwnd, wine_dbgstr_rect(rect));
+    /* a menu has a size that a tooltip does not */
+    if (width < 100 || height < 100) return;
+    if (!(click = (ULONG_PTR)NtUserGetProp(NtUserGetDesktopWindow(), wayland_tray_click_propW)))
+    {
+        TRACE("hwnd=%p no tray click\n", surface->hwnd);
+        return;
+    }
+    /* a window that is shown again for another menu is placed again */
+    if (surface->popup_click == click)
+    {
+        OffsetRect(rect, surface->popup_x - rect->left, surface->popup_y - rect->top);
+        return;
+    }
+    if (NtGetTickCount() - (ULONG)(click >> 32) > 10000)
+    {
+        TRACE("hwnd=%p click too old\n", surface->hwnd);
+        return;
+    }
+    click_x = (click >> 16) & 0xffff;
+    click_y = click & 0xffff;
+
+    pthread_mutex_lock(&process_wayland.output_mutex);
+    wl_list_for_each(output, &process_wayland.output_list, link)
+    {
+        const struct wayland_output_state *state = &output->current;
+        int left = state->logical_x + margin, right = state->logical_x + state->logical_w - margin;
+        int top = state->logical_y + margin, bottom = state->logical_y + state->logical_h - margin;
+
+        if (!state->logical_w || !state->logical_h) continue;
+        TRACE("hwnd=%p click %d,%d output %d,%d %dx%d\n", surface->hwnd, click_x, click_y,
+              state->logical_x, state->logical_y, state->logical_w, state->logical_h);
+        TRACE("hwnd=%p click %d,%d output %d,%d %dx%d\n", surface->hwnd, click_x, click_y,
+              state->logical_x, state->logical_y, state->logical_w, state->logical_h);
+        if (click_x < state->logical_x || click_x >= state->logical_x + state->logical_w ||
+            click_y < state->logical_y || click_y >= state->logical_y + state->logical_h) continue;
+        /* only a click near the edge of the screen, where a panel is */
+        if (click_y - state->logical_y > 200 && state->logical_y + state->logical_h - click_y > 200)
+        {
+            TRACE("hwnd=%p click %d,%d is not at a screen edge\n", surface->hwnd, click_x, click_y);
+            break;
+        }
+
+        rect->left = click_x - width / 2;
+        if (click_y > state->logical_y + state->logical_h / 2) rect->top = click_y - gap - height;
+        else rect->top = click_y + gap;
+        rect->left = max(left, min(rect->left, right - width));
+        rect->top = max(top, min(rect->top, bottom - height));
+        rect->right = rect->left + width;
+        rect->bottom = rect->top + height;
+        surface->popup_click = click;
+        surface->popup_x = rect->left;
+        surface->popup_y = rect->top;
+        TRACE("hwnd=%p click %d,%d placed menu at %s\n", surface->hwnd, click_x, click_y, wine_dbgstr_rect(rect));
+        break;
+    }
+    pthread_mutex_unlock(&process_wayland.output_mutex);
+}
+
+/**********************************************************************
  *          wayland_surface_reconfigure
  *
  * Reconfigures the wayland surface as needed to match the latest requested
@@ -949,7 +1024,10 @@
           wine_dbgstr_rect(&surface->current.rect), surface->current.state);
 
     if (surface->plasma_surface)
+    {
+        wayland_surface_place_popup(surface, &rect);
         org_kde_plasma_surface_set_position(surface->plasma_surface, rect.left, rect.top);
+    }
 
     switch (surface->role)
     {
--- a/dlls/winewayland.drv/systray.c
+++ b/dlls/winewayland.drv/systray.c
@@ -603,6 +603,11 @@
     NtUserMessageCall(owner, callback, wp, lp, 0, NtUserSendNotifyMessage, FALSE);
 }
 
+/* Where the last icon was clicked, in logical coordinates and with the time, on the
+ * desktop window so that the process that opens the menu can find it. */
+const WCHAR wayland_tray_click_propW[] =
+    {'_','_','w','i','n','e','w','a','y','l','a','n','d','_','t','r','a','y','_','c','l','i','c','k',0};
+
 /* The desktop reports positions in logical coordinates, Windows ones are in pixels. */
 static void logical_to_wine(int *x, int *y)
 {
@@ -623,11 +628,39 @@
     pthread_mutex_unlock(&process_wayland.output_mutex);
 }
 
+/* The desktop gives positions in logical coordinates or, from the panel, in pixels:
+ * a point outside the logical size of every output but inside its mode is in pixels. */
+static void click_to_logical(int *x, int *y)
+{
+    struct wayland_output *output;
+
+    pthread_mutex_lock(&process_wayland.output_mutex);
+    wl_list_for_each(output, &process_wayland.output_list, link)
+    {
+        const struct wayland_output_state *state = &output->current;
+
+        if (!state->current_mode || !state->logical_w || !state->logical_h) continue;
+        if (*x >= state->logical_x && *x < state->logical_x + state->logical_w &&
+            *y >= state->logical_y && *y < state->logical_y + state->logical_h) break;
+        if (*x >= state->logical_x && *x < state->logical_x + state->current_mode->width &&
+            *y >= state->logical_y && *y < state->logical_y + state->current_mode->height)
+        {
+            *x = state->logical_x + (*x - state->logical_x) * state->logical_w / state->current_mode->width;
+            *y = state->logical_y + (*y - state->logical_y) * state->logical_h / state->current_mode->height;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&process_wayland.output_mutex);
+}
+
 /* Deliver a click the way Windows does: the button messages, then the
  * version 4 messages when the application asked for them. */
 static void click_icon(HWND owner, UINT callback, UINT id, UINT version, UINT down, UINT up,
                        UINT extra, int x, int y)
 {
+    click_to_logical(&x, &y);
+    NtUserSetProp(NtUserGetDesktopWindow(), wayland_tray_click_propW,
+                  (HANDLE)(((ULONG_PTR)NtGetTickCount() << 32) | ((x & 0xffff) << 16) | (y & 0xffff)));
     logical_to_wine(&x, &y);
     NtUserSetCursorPos(x, y);
     notify_owner(owner, callback, id, version, down, x, y);
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -291,6 +291,8 @@
     struct wp_viewport *wp_viewport;
     struct wp_fractional_scale_v1 *wp_fractional_scale_v1;
     struct org_kde_plasma_surface *plasma_surface;
+    ULONG_PTR popup_click;
+    int popup_x, popup_y;
     struct wayland_shm_buffer *small_icon_buffer;
     struct wayland_shm_buffer *big_icon_buffer;
 
@@ -352,6 +354,7 @@
                                 struct wayland_shm_buffer *shm_buffer,
                                 HRGN surface_damage_region);
 BOOL wayland_surface_reconfigure(struct wayland_surface *surface);
+extern const WCHAR wayland_tray_click_propW[];
 BOOL wayland_surface_config_is_compatible(struct wayland_surface_config *conf, RECT rect,
                                           enum wayland_surface_config_state state);
 RECT map_rect_to_surface(struct wayland_surface *surface, RECT rect);
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -512,6 +512,17 @@
     else if (wayland_win_data_create_wayland_surface(data, owner_surface))
     {
         wayland_win_data_update_wayland_state(data);
+
+        /* A frame that arrived before the configure was processed was not shown, and
+         * nothing paints again for a menu that is already up to date. */
+        if (data->window_contents && data->wayland_surface &&
+            data->wayland_surface->processing.serial && data->wayland_surface->processing.processed &&
+            wayland_surface_reconfigure(data->wayland_surface))
+        {
+            wayland_surface_attach_shm(data->wayland_surface, data->window_contents, NULL);
+            wl_surface_damage_buffer(data->wayland_surface->wl_surface, 0, 0, INT32_MAX, INT32_MAX);
+            wl_surface_commit(data->wayland_surface->wl_surface);
+        }
     }
 
     if (owner_data) wayland_win_data_release(owner_data);
