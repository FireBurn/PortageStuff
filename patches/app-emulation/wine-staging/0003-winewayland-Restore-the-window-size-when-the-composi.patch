From 97bb01806fbe98d8f7a31d037875cbecdf7cf640 Mon Sep 17 00:00:00 2001
From: Mike Lothian <mike@fireburn.co.uk>
Date: Sun, 18 Oct 2026 16:24:45 +0100
Subject: [PATCH 03/11] winewayland: Restore the window size when the
 compositor unmaximizes it.

The maximized style was cleared, but the window kept the maximized size
because the size hints are not used when the state is empty. Send
SC_RESTORE so that the window gets back the rectangle it had before it
was maximized.
---
 dlls/winewayland.drv/waylanddrv.h |  2 ++
 dlls/winewayland.drv/window.c     | 18 ++++++++++++++++++
 2 files changed, 20 insertions(+)

diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
index 1cb525b..dae9059 100644
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -304,6 +304,8 @@ struct wayland_surface
     struct wp_alpha_modifier_surface_v1 *wp_alpha_modifier_surface_v1;
 
     struct wayland_surface_config pending, requested, processing, current;
+    /* The state of the last configure handled, to tell when the compositor unmaximizes the window. */
+    enum wayland_surface_config_state last_configure_state;
     BOOL resizing;
     struct wayland_window_config window;
     int content_width, content_height;
diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index 270fdfb..76d50d6 100644
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -482,6 +482,7 @@ static void wayland_configure_window(HWND hwnd)
     BOOL needs_enter_size_move = FALSE;
     BOOL needs_exit_size_move = FALSE;
     BOOL restoring_from_minimize = FALSE;
+    BOOL was_maximized;
     struct wayland_win_data *data;
     RECT rect, surface_rect;
 
@@ -577,6 +578,23 @@ static void wayland_configure_window(HWND hwnd)
         return;
     }
 
+    /* The compositor unmaximized the window. Windows keeps the rectangle the window had before
+     * it was maximized, let it restore that instead of keeping the maximized size. */
+    style = NtUserGetWindowLongW(hwnd, GWL_STYLE);
+    was_maximized = surface->last_configure_state & WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED;
+    surface->last_configure_state = state;
+    if ((style & WS_MAXIMIZE) && was_maximized &&
+        !(state & (WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED | WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN)))
+    {
+        TRACE("hwnd=%p restoring from maximize\n", hwnd);
+        surface->current = surface->processing;
+        memset(&surface->processing, 0, sizeof(surface->processing));
+        xdg_surface_ack_configure(surface->xdg_surface, surface->current.serial);
+        wayland_win_data_release(data);
+        send_message(hwnd, WM_SYSCOMMAND, SC_RESTORE, 0);
+        return;
+    }
+
     SetRect(&rect, 0, 0, width, height);
     rect = map_rect_from_surface(surface, rect);
     OffsetRect(&rect, data->rects.window.left, data->rects.window.top);
-- 
