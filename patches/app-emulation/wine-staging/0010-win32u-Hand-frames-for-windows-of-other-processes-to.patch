From dad6353095bc4ea8d91ea33bc57fb56102b26f77 Mon Sep 17 00:00:00 2001
From: Mike Lothian <mike@fireburn.co.uk>
Date: Sun, 18 Oct 2026 16:30:41 +0100
Subject: [PATCH 10/11] win32u: Hand frames for windows of other processes to
 the driver.

The surface of a window that belongs to another process cannot be shown
by a driver that has to attach a surface of its own client. Copy each
frame that is presented to such a window to host memory and hand it to
the driver through a new present_pixels client surface function.
---
 dlls/win32u/vulkan.c      | 227 ++++++++++++++++++++++++++++++++++++++
 include/wine/gdi_driver.h |   4 +
 2 files changed, 231 insertions(+)

diff --git a/dlls/win32u/vulkan.c b/dlls/win32u/vulkan.c
index 3265d74..c0f0de9 100644
--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -150,11 +150,29 @@ static struct surface *surface_from_handle( VkSurfaceKHR handle )
     return CONTAINING_RECORD( obj, struct surface, obj );
 }
 
+/* The images of a swapchain for a window that belongs to another process cannot be shown
+ * by the driver, so each presented image is copied to host memory and handed over as pixels. */
+struct remote_present
+{
+    VkFormat format;
+    VkExtent2D extent;
+    uint32_t image_count;
+    VkCommandPool pool;
+    VkCommandBuffer *cmds;
+    VkBuffer buffer;
+    VkDeviceMemory memory;
+    void *map;
+    VkFence fence;
+    VkSemaphore semaphore;
+};
+
 struct swapchain
 {
     struct vulkan_swapchain obj;
     struct surface *surface;
     VkExtent2D extents;
+    VkFormat format;
+    struct remote_present *remote;
 };
 
 static struct swapchain *swapchain_from_handle( VkSwapchainKHR handle )
@@ -1869,6 +1887,196 @@ static BOOL is_color_space_supported( struct vulkan_physical_device *physical_de
     return i < format_count;
 }
 
+static BOOL remote_present_format_is_bgra( VkFormat format, BOOL *bgra )
+{
+    switch (format)
+    {
+    case VK_FORMAT_B8G8R8A8_UNORM:
+    case VK_FORMAT_B8G8R8A8_SRGB:
+        *bgra = TRUE;
+        return TRUE;
+    case VK_FORMAT_R8G8B8A8_UNORM:
+    case VK_FORMAT_R8G8B8A8_SRGB:
+        *bgra = FALSE;
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+static void remote_present_destroy( struct vulkan_device *device, struct swapchain *swapchain )
+{
+    struct remote_present *remote = swapchain->remote;
+
+    if (!remote) return;
+    swapchain->remote = NULL;
+
+    if (remote->semaphore) device->p_vkDestroySemaphore( device->host.device, remote->semaphore, NULL );
+    if (remote->fence) device->p_vkDestroyFence( device->host.device, remote->fence, NULL );
+    if (remote->map) device->p_vkUnmapMemory( device->host.device, remote->memory );
+    if (remote->buffer) device->p_vkDestroyBuffer( device->host.device, remote->buffer, NULL );
+    if (remote->memory) device->p_vkFreeMemory( device->host.device, remote->memory, NULL );
+    if (remote->pool) device->p_vkDestroyCommandPool( device->host.device, remote->pool, NULL );
+    free( remote->cmds );
+    free( remote );
+}
+
+static BOOL remote_present_create( struct vulkan_device *device, struct swapchain *swapchain, uint32_t family )
+{
+    struct vulkan_physical_device *physical_device = device->physical_device;
+    VkMemoryPropertyFlags wanted[] = { VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT | VK_MEMORY_PROPERTY_HOST_CACHED_BIT,
+                                       VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT };
+    VkBufferCreateInfo buffer_info = {.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+                                      .sharingMode = VK_SHARING_MODE_EXCLUSIVE};
+    VkCommandPoolCreateInfo pool_info = {.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO, .queueFamilyIndex = family};
+    VkCommandBufferAllocateInfo cmd_info = {.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO, .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY};
+    VkFenceCreateInfo fence_info = {.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+    VkSemaphoreCreateInfo semaphore_info = {.sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+    VkMemoryRequirements requirements;
+    VkMemoryAllocateInfo alloc_info = {.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    struct remote_present *remote;
+    VkImage *images = NULL;
+    uint32_t i, j;
+    BOOL bgra;
+
+    if (!remote_present_format_is_bgra( swapchain->format, &bgra ))
+    {
+        FIXME( "Format %d of swapchain %p cannot be sent to the window owner\n", swapchain->format, swapchain );
+        return FALSE;
+    }
+    if (!(remote = calloc( 1, sizeof(*remote) ))) return FALSE;
+    swapchain->remote = remote;
+    remote->format = swapchain->format;
+    remote->extent = swapchain->extents;
+
+    if (device->p_vkGetSwapchainImagesKHR( device->host.device, swapchain->obj.host.swapchain, &remote->image_count, NULL ) ||
+        !remote->image_count || !(images = calloc( remote->image_count, sizeof(*images) )) ||
+        device->p_vkGetSwapchainImagesKHR( device->host.device, swapchain->obj.host.swapchain, &remote->image_count, images ))
+        goto failed;
+
+    buffer_info.size = (VkDeviceSize)remote->extent.width * remote->extent.height * 4;
+    if (device->p_vkCreateBuffer( device->host.device, &buffer_info, NULL, &remote->buffer )) goto failed;
+    device->p_vkGetBufferMemoryRequirements( device->host.device, remote->buffer, &requirements );
+    alloc_info.allocationSize = requirements.size;
+    alloc_info.memoryTypeIndex = ~0u;
+    for (j = 0; j < ARRAY_SIZE(wanted) && alloc_info.memoryTypeIndex == ~0u; j++)
+    {
+        for (i = 0; i < physical_device->memory_properties.memoryTypeCount; i++)
+        {
+            if (!(requirements.memoryTypeBits & (1u << i))) continue;
+            if ((physical_device->memory_properties.memoryTypes[i].propertyFlags & wanted[j]) != wanted[j]) continue;
+            alloc_info.memoryTypeIndex = i;
+            break;
+        }
+    }
+    if (alloc_info.memoryTypeIndex == ~0u) goto failed;
+    if (device->p_vkAllocateMemory( device->host.device, &alloc_info, NULL, &remote->memory )) goto failed;
+    if (device->p_vkBindBufferMemory( device->host.device, remote->buffer, remote->memory, 0 )) goto failed;
+    if (device->p_vkMapMemory( device->host.device, remote->memory, 0, VK_WHOLE_SIZE, 0, &remote->map )) goto failed;
+
+    if (device->p_vkCreateCommandPool( device->host.device, &pool_info, NULL, &remote->pool )) goto failed;
+    if (!(remote->cmds = calloc( remote->image_count, sizeof(*remote->cmds) ))) goto failed;
+    cmd_info.commandPool = remote->pool;
+    cmd_info.commandBufferCount = remote->image_count;
+    if (device->p_vkAllocateCommandBuffers( device->host.device, &cmd_info, remote->cmds )) goto failed;
+
+    for (i = 0; i < remote->image_count; i++)
+    {
+        VkCommandBufferBeginInfo begin = {.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+        VkImageSubresourceRange range = {.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT, .levelCount = 1, .layerCount = 1};
+        VkImageMemoryBarrier to_copy =
+        {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, .srcAccessMask = VK_ACCESS_MEMORY_READ_BIT,
+            .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT, .oldLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,
+            .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .image = images[i], .subresourceRange = range,
+        };
+        VkImageMemoryBarrier to_present = to_copy;
+        VkBufferImageCopy copy =
+        {
+            .imageSubresource = {.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT, .layerCount = 1},
+            .imageExtent = {remote->extent.width, remote->extent.height, 1},
+        };
+        VkBufferMemoryBarrier to_host =
+        {
+            .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER, .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+            .dstAccessMask = VK_ACCESS_HOST_READ_BIT, .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .buffer = remote->buffer, .size = VK_WHOLE_SIZE,
+        };
+
+        to_present.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+        to_present.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT;
+        to_present.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+        to_present.newLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
+
+        if (device->p_vkBeginCommandBuffer( remote->cmds[i], &begin )) goto failed;
+        device->p_vkCmdPipelineBarrier( remote->cmds[i], VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0,
+                                0, NULL, 0, NULL, 1, &to_copy );
+        device->p_vkCmdCopyImageToBuffer( remote->cmds[i], images[i], VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, remote->buffer, 1, &copy );
+        device->p_vkCmdPipelineBarrier( remote->cmds[i], VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0,
+                                0, NULL, 1, &to_host, 0, NULL );
+        device->p_vkCmdPipelineBarrier( remote->cmds[i], VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0,
+                                0, NULL, 0, NULL, 1, &to_present );
+        if (device->p_vkEndCommandBuffer( remote->cmds[i] )) goto failed;
+    }
+
+    if (device->p_vkCreateFence( device->host.device, &fence_info, NULL, &remote->fence )) goto failed;
+    if (device->p_vkCreateSemaphore( device->host.device, &semaphore_info, NULL, &remote->semaphore )) goto failed;
+
+    free( images );
+    return TRUE;
+
+failed:
+    free( images );
+    remote_present_destroy( device, swapchain );
+    return FALSE;
+}
+
+/* Copies the image about to be presented and hands its pixels to the driver. Returns the
+ * semaphore the presentation has to wait for instead of the ones it was given. */
+static BOOL remote_present_frame( struct vulkan_device *device, struct vulkan_queue *queue, struct swapchain *swapchain,
+                                  uint32_t image_index, const VkPresentInfoKHR *present_info, VkSemaphore *semaphore )
+{
+    struct client_surface *client = swapchain->surface->client;
+    struct remote_present *remote = swapchain->remote;
+    VkPipelineStageFlags *stages = NULL;
+    VkSubmitInfo submit = {.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO};
+    BOOL bgra = TRUE, ret = FALSE;
+    uint32_t i;
+
+    if (!client->funcs->present_pixels) return FALSE;
+    if (!remote && !remote_present_create( device, swapchain, queue->info.queueFamilyIndex )) return FALSE;
+    remote = swapchain->remote;
+    if (image_index >= remote->image_count) return FALSE;
+
+    if (present_info->waitSemaphoreCount &&
+        !(stages = malloc( present_info->waitSemaphoreCount * sizeof(*stages) )))
+        return FALSE;
+    for (i = 0; i < present_info->waitSemaphoreCount; i++) stages[i] = VK_PIPELINE_STAGE_TRANSFER_BIT;
+
+    submit.waitSemaphoreCount = present_info->waitSemaphoreCount;
+    submit.pWaitSemaphores = present_info->pWaitSemaphores;
+    submit.pWaitDstStageMask = stages;
+    submit.commandBufferCount = 1;
+    submit.pCommandBuffers = &remote->cmds[image_index];
+    submit.signalSemaphoreCount = 1;
+    submit.pSignalSemaphores = &remote->semaphore;
+
+    if (device->p_vkQueueSubmit( queue->host.queue, 1, &submit, remote->fence )) goto done;
+    if (device->p_vkWaitForFences( device->host.device, 1, &remote->fence, VK_TRUE, UINT64_MAX )) goto done;
+    device->p_vkResetFences( device->host.device, 1, &remote->fence );
+
+    remote_present_format_is_bgra( remote->format, &bgra );
+    client->funcs->present_pixels( client, remote->extent.width, remote->extent.height, remote->extent.width * 4,
+                                   bgra, remote->map );
+    *semaphore = remote->semaphore;
+    ret = TRUE;
+
+done:
+    free( stages );
+    return ret;
+}
+
 static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwapchainCreateInfoKHR *create_info,
                                              const VkAllocationCallbacks *allocator, VkSwapchainKHR *ret )
 {
@@ -1920,6 +2128,9 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
         create_info_host.pNext = &scaling;
     }
 
+    /* the pixels are read back from the images when the window belongs to another process */
+    if (surface->client->remote) create_info_host.imageUsage |= VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+
     if (!(swapchain = calloc( 1, sizeof(*swapchain) ))) return VK_ERROR_OUT_OF_HOST_MEMORY;
 
     if ((res = device->p_vkCreateSwapchainKHR( device->host.device, &create_info_host, NULL, &host_swapchain )))
@@ -1931,6 +2142,7 @@ static VkResult win32u_vkCreateSwapchainKHR( VkDevice client_device, const VkSwa
     vulkan_object_init( &swapchain->obj.obj, host_swapchain );
     swapchain->surface = surface;
     swapchain->extents = create_info->imageExtent;
+    swapchain->format = create_info->imageFormat;
     instance->p_insert_object( instance, &swapchain->obj.obj );
 
     *ret = swapchain->obj.client.swapchain;
@@ -1947,6 +2159,7 @@ static void win32u_vkDestroySwapchainKHR( VkDevice client_device, VkSwapchainKHR
     if (allocator) FIXME( "Support for allocation callbacks not implemented yet\n" );
     if (!swapchain) return;
 
+    remote_present_destroy( device, swapchain );
     device->p_vkDestroySwapchainKHR( device->host.device, swapchain->obj.host.swapchain, NULL );
     instance->p_remove_object( instance, &swapchain->obj.obj );
 
@@ -2045,6 +2258,20 @@ static VkResult win32u_vkQueuePresentKHR( VkQueue client_queue, const VkPresentI
         client_surface_update( surface->client );
     }
 
+    /* a window of another process gets the pixels, the image is copied once rendering is done */
+    if (present_info->swapchainCount == 1)
+    {
+        struct swapchain *swapchain = swapchain_from_handle( client_swapchains[0] );
+        VkSemaphore remote_semaphore;
+
+        if (swapchain->surface->client->remote &&
+            remote_present_frame( device, queue, swapchain, present_info->pImageIndices[0], present_info, &remote_semaphore ))
+        {
+            present_info->waitSemaphoreCount = 1;
+            present_info->pWaitSemaphores = &swapchain->remote->semaphore;
+        }
+    }
+
     res = device->p_vkQueuePresentKHR( queue->host.queue, present_info );
 
     for (uint32_t i = 0; i < present_info->swapchainCount; i++)
diff --git a/include/wine/gdi_driver.h b/include/wine/gdi_driver.h
index 4d7d71c..67fa583 100644
--- a/include/wine/gdi_driver.h
+++ b/include/wine/gdi_driver.h
@@ -260,6 +260,9 @@ struct client_surface_funcs
     void (*present)( struct client_surface *surface, HDC hdc );
     /* try to set the client surface color space directly for vulkan pass-through */
     BOOL (*set_color_space)( struct client_surface *surface, VkColorSpaceKHR color_space );
+    /* take the pixels of a presented frame, for surfaces of windows that belong to another process */
+    void (*present_pixels)( struct client_surface *surface, UINT width, UINT height, UINT stride,
+                            BOOL bgra, const void *pixels );
 };
 
 struct client_surface
@@ -275,6 +278,7 @@ struct client_surface
     RECT                               virtual_rect;   /* virtual size and position in the toplevel ancestor, relative to its visible rect */
     RECT                               monitor_rect;   /* raw physical size and position in the toplevel ancestor, relative to its visible rect */
     BOOL                               raw;            /* use the raw physical position and size for the host client surface */
+    BOOL                               remote;         /* the window belongs to another process, frames are sent to it as pixels */
 };
 
 W32KAPI void *client_surface_create( const struct client_surface_funcs *funcs, HWND hwnd, int format, BOOL raw );
