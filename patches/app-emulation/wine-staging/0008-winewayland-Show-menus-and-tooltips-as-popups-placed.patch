+++ b/dlls/winewayland.drv/window.c
@@ -196,6 +196,7 @@ static BOOL wayland_win_data_create_wayland_surface(struct wayland_win_data *dat
 
     if (!visible) role = WAYLAND_SURFACE_ROLE_NONE;
