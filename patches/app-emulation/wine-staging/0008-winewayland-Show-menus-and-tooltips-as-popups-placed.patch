  *          wayland_surface_make_subsurface
  *
@@ -591,6 +686,10 @@ void wayland_surface_clear_role(struct wayland_surface *surface)
 
         surface->owner_hwnd = NULL;
         break;
+
+    case WAYLAND_SURFACE_ROLE_POPUP:
+        wayland_surface_destroy_popup(surface);
+        break;
     }
 
     memset(&surface->pending, 0, sizeof(surface->pending));
@@ -928,6 +1027,135 @@ static void wayland_surface_reconfigure_subsurface(struct wayland_surface *surfa
     wayland_win_data_release(owner_data);
 }
 
+/**********************************************************************
+ *          wayland_hwnd_wants_popup
+ *
+ * Whether a window is a menu or tooltip that should be shown as a popup
+ * placed by the compositor, and the compositor can place one.
+ */
+BOOL wayland_hwnd_wants_popup(HWND hwnd)
+{
+    UINT style = NtUserGetWindowLongW(hwnd, GWL_STYLE);
+    UINT ex_style = NtUserGetWindowLongW(hwnd, GWL_EXSTYLE);
+
+    if (!process_wayland.xx_output_popup_manager_v1 && !process_wayland.zwlr_layer_shell_v1) return FALSE;
+    return (style & WS_POPUP) && (style & WS_CAPTION) != WS_CAPTION && (ex_style & WS_EX_TOOLWINDOW);
+}
+
+/**********************************************************************
+ *          wayland_surface_make_popup
+ *
+ * Gives the popup role to a plain wayland surface. The popup itself is
+ * created when its position is known.
+ */
+void wayland_surface_make_popup(struct wayland_surface *surface)
+{
+    assert(!surface->role || surface->role == WAYLAND_SURFACE_ROLE_POPUP);
+    if (surface->role == WAYLAND_SURFACE_ROLE_POPUP) return;
+
+    wayland_surface_clear_role(surface);
+    surface->role = WAYLAND_SURFACE_ROLE_POPUP;
+}
+
+static void wayland_surface_realize_popup(struct wayland_surface *surface, RECT rect)
+{
+    int width = rect.right - rect.left, height = rect.bottom - rect.top;
+    struct wayland_output *output, *found = NULL;
+    int x, y;
+
+    if (width <= 0 || height <= 0) return;
+
+    pthread_mutex_lock(&process_wayland.output_mutex);
+    wl_list_for_each(output, &process_wayland.output_list, link)
+    {
+        const struct wayland_output_state *state = &output->current;
+
+        if (!state->logical_w || !state->logical_h) continue;
+        if (!found) found = output;
+        if (rect.left >= state->logical_x && rect.left < state->logical_x + state->logical_w &&
+            rect.top >= state->logical_y && rect.top < state->logical_y + state->logical_h)
+        {
+            found = output;
+            break;
+        }
+    }
+    if (!found)
+    {
+        pthread_mutex_unlock(&process_wayland.output_mutex);
+        return;
+    }
+    x = rect.left - found->current.logical_x;
+    y = rect.top - found->current.logical_y;
+
+    TRACE("hwnd=%p popup at %d,%d %dx%d\n", surface->hwnd, x, y, width, height);
+
+    if (process_wayland.xx_output_popup_manager_v1)
+    {
+        struct xdg_positioner *positioner;
+
+        if (!(surface->xdg_surface = xdg_wm_base_get_xdg_surface(process_wayland.xdg_wm_base,
+                                                                 surface->wl_surface))) goto err;
+        xdg_surface_add_listener(surface->xdg_surface, &xdg_surface_listener, surface->hwnd);
+
+        positioner = xdg_wm_base_create_positioner(process_wayland.xdg_wm_base);
+        xdg_positioner_set_size(positioner, width, height);
+        xdg_positioner_set_anchor_rect(positioner, x, y, 1, 1);
+        xdg_positioner_set_anchor(positioner, XDG_POSITIONER_ANCHOR_TOP_LEFT);
+        xdg_positioner_set_gravity(positioner, XDG_POSITIONER_GRAVITY_BOTTOM_RIGHT);
+        xdg_positioner_set_constraint_adjustment(positioner,
+                                                 XDG_POSITIONER_CONSTRAINT_ADJUSTMENT_SLIDE_X |
+                                                 XDG_POSITIONER_CONSTRAINT_ADJUSTMENT_SLIDE_Y |
+                                                 XDG_POSITIONER_CONSTRAINT_ADJUSTMENT_FLIP_Y);
+        surface->xdg_popup = xdg_surface_get_popup(surface->xdg_surface, NULL, positioner);
+        xdg_positioner_destroy(positioner);
+        if (!surface->xdg_popup) goto err;
+        xdg_popup_add_listener(surface->xdg_popup, &xdg_popup_listener, surface->hwnd);
+
+        surface->xx_output_popup_v1 =
+            xx_output_popup_manager_v1_get_output_parent(process_wayland.xx_output_popup_manager_v1,
+                                                         surface->xdg_popup, found->wl_output, NULL);
+        if (!surface->xx_output_popup_v1) goto err;
+    }
+    else
+    {
+        struct zwlr_layer_surface_v1 *layer;
+
+        layer = zwlr_layer_shell_v1_get_layer_surface(process_wayland.zwlr_layer_shell_v1,
+                                                      surface->wl_surface, found->wl_output,
+                                                      ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY, "wine");
+        if (!(surface->zwlr_layer_surface_v1 = layer)) goto err;
+        zwlr_layer_surface_v1_add_listener(layer, &layer_surface_listener, surface->hwnd);
+        zwlr_layer_surface_v1_set_size(layer, width, height);
+        zwlr_layer_surface_v1_set_anchor(layer, ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP |
+                                                ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT);
+        zwlr_layer_surface_v1_set_margin(layer, y, 0, 0, x);
+        zwlr_layer_surface_v1_set_exclusive_zone(layer, -1);
+    }
+    pthread_mutex_unlock(&process_wayland.output_mutex);
+
+    if (!surface->wp_fractional_scale_v1) wayland_surface_init_fractional_scale(surface, surface->window.scale);
+    surface->popup_rect = rect;
+
+    wl_surface_commit(surface->wl_surface);
+    wl_display_flush(process_wayland.wl_display);
+    return;
+
+err:
+    pthread_mutex_unlock(&process_wayland.output_mutex);
+    wayland_surface_destroy_popup(surface);
+    ERR("Failed to create the popup for wayland surface\n");
+}
+
+static BOOL wayland_surface_reconfigure_popup(struct wayland_surface *surface, RECT rect)
+{
+    if ((surface->xdg_surface || surface->zwlr_layer_surface_v1) && !EqualRect(&rect, &surface->popup_rect))
+        wayland_surface_destroy_popup(surface);
+    if (!surface->xdg_surface && !surface->zwlr_layer_surface_v1)
+        wayland_surface_realize_popup(surface, rect);
+
+    return surface->current.serial != 0;
+}
+
 /**********************************************************************
  *          wayland_surface_reconfigure
  *
@@ -956,6 +1184,9 @@ BOOL wayland_surface_reconfigure(struct wayland_surface *surface)
         if (!surface->wl_subsurface) break; /* surface role has been cleared */
         wayland_surface_reconfigure_subsurface(surface);
         break;
+    case WAYLAND_SURFACE_ROLE_POPUP:
+        if (!wayland_surface_reconfigure_popup(surface, rect)) return FALSE;
+        break;
     }
 
     wayland_surface_reconfigure_size(surface, rect.right - rect.left, rect.bottom - rect.top);
