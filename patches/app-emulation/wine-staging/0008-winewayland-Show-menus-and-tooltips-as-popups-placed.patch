+    The above copyright notice and this permission notice (including the next
+    paragraph) shall be included in all copies or substantial portions of the
+    Software.
+
+    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+    THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+    DEALINGS IN THE SOFTWARE.
+  </copyright>
+
+  <interface name="xx_output_popup_manager_v1" version="1">
+    <description summary="popups anchored to an output">
+      A client that is asked to show a menu for something it has no window
+      for, such as an icon in a system tray, cannot use xdg_popup: the
+      popup needs a parent surface and the client has none. This protocol
+      lets such a client use an output as the parent of an xdg_popup.
+
+      The xdg_surface.get_popup request already allows a null parent when
+      the parent is set by another protocol before the initial commit. This
+      is that protocol. It changes nothing for popups that have a parent.
+
+      Warning! The protocol described in this file is currently in the
+      testing phase. Backward compatible changes may be added together with
+      the corresponding interface version bump. Backward incompatible
+      changes can only be done by creating a new major version of the
+      extension.
+    </description>
+
+    <enum name="error">
+      <entry name="invalid_popup" value="0"
+             summary="the xdg_popup already has a parent or was committed"/>
+      <entry name="already_constructed" value="1"
+             summary="the xdg_popup already has an output parent object"/>
+    </enum>
+
+    <request name="destroy" type="destructor">
+      <description summary="destroy the manager">
+        Destroy the manager. Parent objects created through it are not
+        affected.
+      </description>
+    </request>
+
+    <request name="get_output_parent">
+      <description summary="create a parent object for an xdg_popup">
+        Make an output the parent of an xdg_popup that was created with a
+        null parent. This must happen before the first commit of the
+        xdg_surface.
+
+        The anchor rectangle of the xdg_positioner used for the popup is
+        in the logical coordinate space of the output, relative to its
+        top left corner, instead of the window geometry of a parent.
+        Constraint adjustments apply to the usable area of the output, the
+        part that panels and docks do not cover.
+
+        The activation token proves that the popup follows an interaction
+        of the user, such as the activation of an item in a system tray. It
+        was obtained through xdg_activation_v1 or the protocol of the item.
+        A compositor may refuse a popup without a valid token by sending
+        xdg_popup.popup_done before it is mapped.
+
+        The client has no input serial for that interaction, so it cannot
+        use xdg_popup.grab. A compositor that accepts the token should
+        dismiss the popup on a click outside it and on the keyboard, as it
+        does for a popup with a grab.
+      </description>
+      <arg name="id" type="new_id" interface="xx_output_popup_v1"/>
+      <arg name="popup" type="object" interface="xdg_popup"/>
+      <arg name="output" type="object" interface="wl_output"/>
+      <arg name="token" type="string" allow-null="true"
+           summary="xdg_activation_v1 token"/>
+    </request>
+  </interface>
+
+  <interface name="xx_output_popup_v1" version="1">
+    <description summary="output parent of an xdg_popup">
+      The association between an xdg_popup and the output it is anchored to.
+      It ends with the xdg_popup or when destroyed, and the xdg_popup is
+      then dismissed.
+    </description>
+
+    <request name="destroy" type="destructor">
+      <description summary="destroy the object">
+        The xdg_popup is dismissed if it is still mapped.
+      </description>
+    </request>
+
+    <request name="set_output">
+      <description summary="move the popup to another output">
+        Anchor the popup to another output. It takes effect on the next
+        commit of the xdg_surface, as the anchor rectangle does.
+      </description>
+      <arg name="output" type="object" interface="wl_output"/>
+    </request>
+  </interface>
+</protocol>
