@@ -226,6 +233,68 @@ static const struct xdg_toplevel_listener xdg_toplevel_listener =
     xdg_toplevel_handle_close
 };
 
+static void popup_dismissed(HWND hwnd)
+{
+    TRACE("hwnd=%p\n", hwnd);
+    NtUserPostMessage(hwnd, WM_CANCELMODE, 0, 0);
+}
+
+static void xdg_popup_handle_configure(void *private, struct xdg_popup *xdg_popup,
+                                       int32_t x, int32_t y, int32_t width, int32_t height)
+{
+    TRACE("hwnd=%p %d,%d %dx%d\n", private, x, y, width, height);
+}
+
+static void xdg_popup_handle_popup_done(void *private, struct xdg_popup *xdg_popup)
+{
+    popup_dismissed(private);
+}
+
+static void xdg_popup_handle_repositioned(void *private, struct xdg_popup *xdg_popup, uint32_t token)
+{
+}
+
+static const struct xdg_popup_listener xdg_popup_listener =
+{
+    xdg_popup_handle_configure,
+    xdg_popup_handle_popup_done,
+    xdg_popup_handle_repositioned
+};
+
+static void layer_surface_handle_configure(void *private, struct zwlr_layer_surface_v1 *layer_surface,
+                                           uint32_t serial, uint32_t width, uint32_t height)
+{
+    struct wayland_surface *surface;
+    struct wayland_win_data *data;
+    BOOL initial_configure = FALSE;
+    HWND hwnd = private;
+
+    TRACE("hwnd=%p serial=%u %ux%u\n", hwnd, serial, width, height);
+
+    if (!(data = wayland_win_data_get(hwnd))) return;
+    if ((surface = data->wayland_surface) && surface->role == WAYLAND_SURFACE_ROLE_POPUP &&
+        surface->zwlr_layer_surface_v1 == layer_surface)
+    {
+        zwlr_layer_surface_v1_ack_configure(layer_surface, serial);
+        initial_configure = surface->current.serial == 0;
+        surface->current.serial = serial;
+    }
+    wayland_win_data_release(data);
+
+    if (initial_configure) NtUserExposeWindowSurface(hwnd, 0, NULL);
+}
+
+static void layer_surface_handle_closed(void *private, struct zwlr_layer_surface_v1 *layer_surface)
+{
+    popup_dismissed(private);
+}
+
+static const struct zwlr_layer_surface_v1_listener layer_surface_listener =
+{
+    layer_surface_handle_configure,
+    layer_surface_handle_closed
+};
+
 void wp_fractional_scale_handle_scale(void* user_data,
                                       struct wp_fractional_scale_v1 *fractional_scale_v1,
                                       uint32_t scale_fixed)
@@ -486,6 +555,32 @@ err:
     ERR("Failed to assign toplevel role to wayland surface\n");
 }
 
+static void wayland_surface_destroy_popup(struct wayland_surface *surface)
+{
+    if (surface->zwlr_layer_surface_v1)
+    {
+        zwlr_layer_surface_v1_destroy(surface->zwlr_layer_surface_v1);
+        surface->zwlr_layer_surface_v1 = NULL;
+    }
+    if (surface->xx_output_popup_v1)
+    {
+        xx_output_popup_v1_destroy(surface->xx_output_popup_v1);
+        surface->xx_output_popup_v1 = NULL;
+    }
+    if (surface->xdg_popup)
+    {
+        xdg_popup_destroy(surface->xdg_popup);
+        surface->xdg_popup = NULL;
+    }
+    if (surface->xdg_surface)
+    {
+        xdg_surface_destroy(surface->xdg_surface);
+        surface->xdg_surface = NULL;
+    }
+    memset(&surface->current, 0, sizeof(surface->current));
+    SetRectEmpty(&surface->popup_rect);
+}
