index 10915b1..31588a2 100644
--- a/dlls/winewayland.drv/Makefile.in
+++ b/dlls/winewayland.drv/Makefile.in
@@ -1,6 +1,6 @@
 MODULE = winewayland.drv
 UNIXLIB = winewayland.so
-UNIX_CFLAGS = $(EGL_CFLAGS) $(WAYLAND_CLIENT_CFLAGS) $(WAYLAND_EGL_CFLAGS) $(XKBCOMMON_CFLAGS) $(XKBREGISTRY_CFLAGS)
+UNIX_CFLAGS = $(DBUS_CFLAGS) $(EGL_CFLAGS) $(WAYLAND_CLIENT_CFLAGS) $(WAYLAND_EGL_CFLAGS) $(XKBCOMMON_CFLAGS) $(XKBREGISTRY_CFLAGS)
 UNIX_LIBS = -lwin32u $(WAYLAND_CLIENT_LIBS) $(WAYLAND_EGL_LIBS) $(XKBCOMMON_LIBS) $(XKBREGISTRY_LIBS) $(PTHREAD_LIBS) -lm
 IMPORTS = user32 win32u
 
@@ -11,6 +11,7 @@ SOURCES = \
 	opengl.c \
 	pointer-constraints-unstable-v1.xml \
 	relative-pointer-unstable-v1.xml \
+	systray.c \
 	text-input-unstable-v3.xml \
 	version.rc \
 	viewporter.xml \
diff --git a/dlls/winewayland.drv/dllmain.c b/dlls/winewayland.drv/dllmain.c
index 8055d88..8871d77 100644
--- a/dlls/winewayland.drv/dllmain.c
+++ b/dlls/winewayland.drv/dllmain.c
@@ -93,6 +93,21 @@ static DWORD WINAPI clipboard_thread(void *arg)
     return 0;
 }
 
+static DWORD WINAPI systray_thread(void *arg)
+{
+    WAYLANDDRV_UNIX_CALL(systray_run, NULL);
+    return 0;
+}
+
+static BOOL is_explorer_process(void)
+{
+    WCHAR path[MAX_PATH], *name;
+
+    if (!GetModuleFileNameW(NULL, path, ARRAY_SIZE(path))) return FALSE;
+    name = wcsrchr(path, '\\');
+    return !lstrcmpiW(name ? name + 1 : path, L"explorer.exe");
+}
+
 BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
 {
     DWORD tid;
@@ -111,5 +126,9 @@ BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
     if (!WAYLANDDRV_UNIX_CALL(init_clipboard, NULL))
         CloseHandle(CreateThread(NULL, 0, clipboard_thread, NULL, 0, &tid));
 
+    /* The system tray lives in explorer, which needs a thread to answer the desktop's requests. */
+    if (is_explorer_process())
+        CloseHandle(CreateThread(NULL, 0, systray_thread, NULL, 0, &tid));
+
     return TRUE;
 }
diff --git a/dlls/winewayland.drv/systray.c b/dlls/winewayland.drv/systray.c
new file mode 100644
index 0000000..882a209
--- /dev/null
+++ b/dlls/winewayland.drv/systray.c
@@ -0,0 +1,754 @@
