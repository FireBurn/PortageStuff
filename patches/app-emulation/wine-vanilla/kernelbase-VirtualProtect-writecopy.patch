From 8deffe7b85712ff39df030a90178f7f7038d48dc Mon Sep 17 00:00:00 2001
From: Mike Lothian <mike@fireburn.co.uk>
Date: Sun, 18 Oct 2026 19:40:33 +0100
Subject: [PATCH] kernelbase: Report PAGE_WRITECOPY as PAGE_READWRITE from
 VirtualProtect().

The 32-bit libcef helper processes of Battle.net stop at a breakpoint
right after they start when VirtualProtect() returns PAGE_WRITECOPY as
the old protection. They run when it is reported as PAGE_READWRITE
instead, which is what wine-staging does. Also accept a NULL old_prot.
---
 dlls/kernelbase/memory.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/dlls/kernelbase/memory.c b/dlls/kernelbase/memory.c
index 2ce2dca..34f4e21 100644
--- a/dlls/kernelbase/memory.c
+++ b/dlls/kernelbase/memory.c
@@ -553,7 +553,12 @@ BOOL WINAPI DECLSPEC_HOTPATCH  VirtualLock( void *addr, SIZE_T size )
  */
 BOOL WINAPI DECLSPEC_HOTPATCH VirtualProtect( void *addr, SIZE_T size, DWORD new_prot, DWORD *old_prot )
 {
-    return VirtualProtectEx( GetCurrentProcess(), addr, size, new_prot, old_prot );
+    BOOL ret = VirtualProtectEx( GetCurrentProcess(), addr, size, new_prot, old_prot );
+
+    /* Programs restore the protection they were given, and Wine does not support
+     * PAGE_WRITECOPY for every kind of mapping, so report the writable protection. */
+    if (old_prot && *old_prot == PAGE_WRITECOPY) *old_prot = PAGE_READWRITE;
+    return ret;
 }
 
 
