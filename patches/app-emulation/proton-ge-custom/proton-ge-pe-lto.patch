Build the PE side with thin LTO.

The PE build links with -flto=thin, with LLVM that finds the symbols inline asm
defines. Two things still do not go through it.

The static runtime libraries: LTO code generation emits calls to library
functions such as fetestexcept and _dsign, and lld cannot take a bitcode
archive member for them after code generation has run. Compile them without LTO.

wow64 calls two functions from module level asm. Asm can only name a symbol the
linker knows, so they cannot be static.

--- a/dlls/winecrt0/Makefile.in
+++ b/dlls/winecrt0/Makefile.in
@@ -1,4 +1,5 @@
 STATICLIB = libwinecrt0.a
+EXTRADEFS = -fno-lto
 
 SOURCES = \
 	arm64ec.c \
--- a/dlls/wow64/syscall.c
+++ b/dlls/wow64/syscall.c
@@ -102,7 +102,7 @@
 static void     (WINAPI *pBTCpuProcessInit)(void);
 static NTSTATUS (WINAPI *pBTCpuSetContext)(HANDLE,HANDLE,void *,void *);
 static void     (WINAPI *pBTCpuThreadInit)(void);
-static void     (WINAPI *pBTCpuSimulate)(void) __attribute__((used));
+void     (WINAPI *pBTCpuSimulate)(void) __attribute__((used));
 static void *   (WINAPI *p__wine_get_unix_opcode)(void);
 static void *   (WINAPI *pKiRaiseUserExceptionDispatcher)(void);
 void     (WINAPI *pBTCpuFlushInstructionCache2)( const void *, SIZE_T ) = NULL;
@@ -195,7 +195,7 @@
 /**********************************************************************
  *           call_user_exception_dispatcher
  */
-static void __attribute__((used)) call_user_exception_dispatcher( EXCEPTION_RECORD32 *rec, void *ctx32_ptr,
+void __attribute__((used)) call_user_exception_dispatcher( EXCEPTION_RECORD32 *rec, void *ctx32_ptr,
                                                                   void *ctx64_ptr )
 {
     switch (current_machine)
@@ -298,7 +298,7 @@
 /**********************************************************************
  *           call_raise_user_exception_dispatcher
  */
-static void __attribute__((used)) call_raise_user_exception_dispatcher( ULONG code )
+void __attribute__((used)) call_raise_user_exception_dispatcher( ULONG code )
 {
     NtCurrentTeb32()->ExceptionCode = code;
 
--- a/libs/compiler-rt/Makefile.in
+++ b/libs/compiler-rt/Makefile.in
@@ -1,4 +1,5 @@
 EXTLIB    = libcompiler-rt.a
+EXTRADEFS = -fno-lto
 
 SOURCES = \
 	lib/builtins/arm/aeabi_idivmod.S \
--- a/libs/musl/Makefile.in
+++ b/libs/musl/Makefile.in
@@ -1,6 +1,6 @@
 EXTLIB    = libmusl.a
 EXTRAINCL = -I$(srcdir)/src/internal -I$(srcdir)/arch/generic
-EXTRADEFS = -D_ACRTIMP= -D_NO_CRT_MATH_INLINE \
+EXTRADEFS = -fno-lto -D_ACRTIMP= -D_NO_CRT_MATH_INLINE \
             -fno-builtin
 
 SOURCES = \
