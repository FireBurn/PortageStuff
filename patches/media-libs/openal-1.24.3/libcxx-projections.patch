Use lambdas rather than the address of unique_ptr::operator* as projections.
The standard does not let a program take the address of a library member
function, and libc++ declares operator* so that it cannot be deduced.

diff -ru a/alc/alc.cpp b/alc/alc.cpp
--- a/alc/alc.cpp
+++ b/alc/alc.cpp
@@ -1781,7 +1781,8 @@
          * configuration in aluInitEffectPanning.
          */
         std::ranges::for_each(context->mEffectSlotClusters
-            | std::views::transform(&ContextBase::EffectSlotCluster::operator*)
+            | std::views::transform([](ContextBase::EffectSlotCluster const &cluster)
+                -> auto& { return *cluster; })
             | std::views::join, [](EffectSlotBase &slot)
         {
             slot.mWetBuffer.clear();
diff -ru a/alc/backends/pipewire.cpp b/alc/backends/pipewire.cpp
--- a/alc/backends/pipewire.cpp
+++ b/alc/backends/pipewire.cpp
