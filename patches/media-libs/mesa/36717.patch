diff --git a/src/vulkan/device-select-layer/.clang-format b/src/vulkan/device-select-layer/.clang-format
new file mode 100644
index 0000000000000..0b35d842f42a6
--- /dev/null
+++ b/src/vulkan/device-select-layer/.clang-format
@@ -0,0 +1,4 @@
+BasedOnStyle: InheritParentConfig
+DisableFormat: false
+
+ColumnLimit: 100
