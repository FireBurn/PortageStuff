+      const char *name;
+      VkPhysicalDeviceType type;
+   } names[] = {
+      {"other", VK_PHYSICAL_DEVICE_TYPE_OTHER},
+      {"integrated", VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU},
