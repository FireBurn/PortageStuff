@@ -30,27 +30,35 @@
 /* We don't use `drmPciDeviceInfo` because it uses 16-bit ids,
  * instead of Vulkan's 32-bit ones. */
 struct device_info {
-  uint32_t vendor_id;
-  uint32_t device_id;
+   uint32_t vendor_id;
+   uint32_t device_id;
 };
 
 struct device_pci_info {
-  struct device_info dev_info;
-  drmPciBusInfo bus_info;
-  bool has_bus_info;
-  bool cpu_device;
+   struct device_info dev_info;
+   drmPciBusInfo bus_info;
+   bool has_bus_info;
+   bool cpu_device;
 };
 
