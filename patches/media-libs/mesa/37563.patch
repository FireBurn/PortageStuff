From 3701985930ca04fcffc2b7b463e536ead7aa0335 Mon Sep 17 00:00:00 2001
From: Karol Herbst <kherbst@redhat.com>
Date: Thu, 25 Sep 2025 11:42:33 +0200
Subject: [PATCH] rusticl: add debug option to use the LLVM SPIR-V target

---
 docs/envvars.rst                                         | 1 +
 src/gallium/frontends/rusticl/core/platform.rs           | 3 +++
 src/gallium/frontends/rusticl/core/program.rs            | 1 +
 src/gallium/frontends/rusticl/mesa/compiler/clc/spirv.rs | 4 +++-
 4 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/docs/envvars.rst b/docs/envvars.rst
index 050f0c35de0e4..7ed7861e3701d 100644
--- a/docs/envvars.rst
+++ b/docs/envvars.rst
@@ -1237,6 +1237,7 @@ Rusticl environment variables
    - ``perfspam`` same as perf, but doesn't skip same warnings
    - ``program`` dumps compilation logs to stderr
    - ``sync`` waits on the GPU to complete after every event
+   - ``use_llvm_spirv_target`` uses the LLVM SPIR-V target instead of the SPIRV-LLVM-Translator
    - ``validate`` validates any internally generated SPIR-Vs, e.g. through compiling OpenCL C code
 
 .. envvar:: RUSTICL_MAX_WORK_GROUPS
diff --git a/src/gallium/frontends/rusticl/core/platform.rs b/src/gallium/frontends/rusticl/core/platform.rs
index 5f2a3e704e481..bc8007f730709 100644
--- a/src/gallium/frontends/rusticl/core/platform.rs
+++ b/src/gallium/frontends/rusticl/core/platform.rs
@@ -68,6 +68,7 @@ pub struct PlatformDebug {
     pub program: bool,
     pub reuse_context: bool,
     pub sync_every_event: bool,
+    pub use_llvm_spirv_target: bool,
     pub validate_spirv: bool,
 }
 
@@ -98,6 +99,7 @@ static mut PLATFORM_DBG: PlatformDebug = PlatformDebug {
     program: false,
     reuse_context: true,
     sync_every_event: false,
+    use_llvm_spirv_target: false,
     validate_spirv: false,
 };
 static mut PLATFORM_FEATURES: PlatformFeatures = PlatformFeatures {
@@ -121,6 +123,7 @@ fn load_env() {
                 "perfspam" => debug.perf = PerfDebugLevel::Spam,
                 "program" => debug.program = true,
                 "sync" => debug.sync_every_event = true,
+                "use_llvm_spirv_target" => debug.use_llvm_spirv_target = true,
                 "validate" => debug.validate_spirv = true,
                 "" => (),
                 _ => eprintln!("Unknown RUSTICL_DEBUG flag found: {}", flag),
diff --git a/src/gallium/frontends/rusticl/core/program.rs b/src/gallium/frontends/rusticl/core/program.rs
index f884e0f067100..fcc51c1f91920 100644
--- a/src/gallium/frontends/rusticl/core/program.rs
+++ b/src/gallium/frontends/rusticl/core/program.rs
@@ -665,6 +665,7 @@ impl Program {
                     device.cl_features(),
                     &device.spirv_extensions,
                     device.address_bits(),
+                    Platform::dbg().use_llvm_spirv_target,
                 );
 
                 if Platform::dbg().validate_spirv {
diff --git a/src/gallium/frontends/rusticl/mesa/compiler/clc/spirv.rs b/src/gallium/frontends/rusticl/mesa/compiler/clc/spirv.rs
index 3482bb045e322..77d717bd9930d 100644
--- a/src/gallium/frontends/rusticl/mesa/compiler/clc/spirv.rs
+++ b/src/gallium/frontends/rusticl/mesa/compiler/clc/spirv.rs
@@ -99,6 +99,7 @@ impl SPIRVBin {
         features: clc_optional_features,
         spirv_extensions: &[&CStr],
         address_bits: u32,
+        use_llvm_spirv_target: bool,
     ) -> (Option<Self>, String) {
         let mut hash_key = None;
         let has_includes = args.iter().any(|a| a.as_bytes()[0..2] == *b"-I");
@@ -117,6 +118,7 @@ impl SPIRVBin {
                     key.extend_from_slice(h.name.as_bytes());
                     key.extend_from_slice(h.source.as_bytes());
                 });
+                key.push(use_llvm_spirv_target.into());
 
                 // Safety: clc_optional_features is a struct of bools and contains no padding.
                 // Sadly we can't guarentee this.
@@ -152,7 +154,7 @@ impl SPIRVBin {
             num_args: c_args.len() as u32,
             spirv_version: clc_spirv_version::CLC_SPIRV_VERSION_MAX,
             features: features,
-            use_llvm_spirv_target: false,
+            use_llvm_spirv_target: use_llvm_spirv_target,
             allowed_spirv_extensions: spirv_extensions.as_ptr(),
             c_compatible: false,
             address_bits: address_bits,
