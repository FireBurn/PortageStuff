diff -urN a/stap-filebuf.h b/stap-filebuf.h
--- a/stap-filebuf.h
+++ b/stap-filebuf.h
@@ -0,0 +1,84 @@
+#ifndef STAP_FILEBUF_H
+#define STAP_FILEBUF_H
+
+#include <ios>
+#include <streambuf>
+#include <unistd.h>
+
+#ifdef __GLIBCXX__
+#include <ext/stdio_filebuf.h>
+#else
+// libc++ has no stdio_filebuf: a minimal fd-owning streambuf with the same use
+namespace __gnu_cxx {
+template <typename C>
+class stdio_filebuf : public std::basic_streambuf<C>
+{
+  int fd;
+  C ibuf[4096];
+  C obuf[4096];
+
+public:
+  stdio_filebuf(int f, std::ios_base::openmode m) : fd(f)
+  {
+    if (m & std::ios_base::out)
+      this->setp(obuf, obuf + sizeof obuf / sizeof(C));
+  }
+
+  ~stdio_filebuf()
+  {
+    close();
+  }
+
+  stdio_filebuf *close()
+  {
+    if (fd < 0)
+      return nullptr;
+    sync();
+    ::close(fd);
+    fd = -1;
+    return this;
+  }
+
+protected:
+  typename std::basic_streambuf<C>::int_type underflow()
+  {
+    ssize_t n = read(fd, ibuf, sizeof ibuf);
+    if (n <= 0)
+      return std::basic_streambuf<C>::traits_type::eof();
+    this->setg(ibuf, ibuf, ibuf + n / sizeof(C));
+    return std::basic_streambuf<C>::traits_type::to_int_type(*ibuf);
+  }
+
+  typename std::basic_streambuf<C>::int_type overflow(typename std::basic_streambuf<C>::int_type c)
+  {
+    if (sync() != 0)
+      return std::basic_streambuf<C>::traits_type::eof();
+    if (!std::basic_streambuf<C>::traits_type::eq_int_type(c, std::basic_streambuf<C>::traits_type::eof()))
+      {
+        *this->pptr() = std::basic_streambuf<C>::traits_type::to_char_type(c);
+        this->pbump(1);
+      }
+    return std::basic_streambuf<C>::traits_type::not_eof(c);
+  }
+
+  int sync()
+  {
+    const char *p = reinterpret_cast<const char *>(this->pbase());
+    size_t left = (this->pptr() - this->pbase()) * sizeof(C);
+    while (left > 0)
+      {
+        ssize_t n = write(fd, p, left);
+        if (n < 0)
+          return -1;
+        p += n;
+        left -= n;
+      }
+    this->setp(obuf, obuf + sizeof obuf / sizeof(C));
+    return 0;
+  }
+};
+}
+using namespace __gnu_cxx;
+#endif
+
+#endif
