-extern "C" {
-
-JNIEXPORT jboolean JNICALL Java_org_citron_citron_1emu_NativeLibrary_isFirmwareAvailable(
-    JNIEnv* env, jobject obj) {
-    return Core::Crypto::KeyManager::Instance().IsFirmwareAvailable();
